	anonTrack.InputBegan:Connect(function(i)
		if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
		anonymous=not anonymous
		if anonymous then
			displayNameLbl.Text="Anonymous";usernameLbl.Text="@hidden";userIdLbl.Text="••••••••"
			clockLbl.Text="••:••:•• ••";dateLbl.Text="••• ••, ••••"

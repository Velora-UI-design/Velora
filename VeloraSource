				end
				task.delay(0.8, function()
					dismiss()
					task.delay(0.4, onSuccess)
				end)
			else
				setStatus("Invalid key. Please try again.", C.red)
				tween:Create(verifyBtn, TweenInfo.new(0.15), { BackgroundColor3 = C.purple }):Play()
			end
		end)
	end)


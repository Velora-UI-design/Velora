	local dateLbl=newInst("TextLabel",{Size=UDim2.new(1,0,0,16),Position=UDim2.new(0,0,0,250),
		BackgroundTransparency=1,Text="",TextColor3=C.textDim,
		TextXAlignment=Enum.TextXAlignment.Center,Font=Enum.Font.Gotham,TextSize=10,ZIndex=52,Parent=panel})

	local MONTHS={"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}
	local clockConn=RunSvc.Heartbeat:Connect(function()
		if not panel.Parent then return end
		local t=os.date("*t")
		local h=t.hour;local ampm=h>=12 and "PM" or "AM"
		h=h%12;if h==0 then h=12 end
		if not anonymous then
			clockLbl.Text=string.format("%d:%02d:%02d %s",h,t.min,t.sec,ampm)
			dateLbl.Text=MONTHS[t.month].." "..string.format("%02d",t.day)..", "..t.year

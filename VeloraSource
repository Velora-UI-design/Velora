		-- Slider
		function tabObj:CreateSlider(cfg2)
			cfg2=cfg2 or {}
			local range=cfg2.Range or {0,100};local inc=cfg2.Increment or 1
			local suffix=cfg2.Suffix or "";local cur=cfg2.CurrentValue or range[1]
			local sendNotif=cfg2.SendNotification==true
			if cfg2.Flag then flags[cfg2.Flag]=cur end
			local row=makeRow(64);rowLabel(cfg2.Name or "Slider",nil,row)
			table.insert(allElements,{frame=row,name=cfg2.Name or "Slider"})
			local valLbl=newInst("TextLabel",{Size=UDim2.new(0,80,0,18),Position=UDim2.new(1,-88,0,14),
				BackgroundTransparency=1,Text=tostring(cur).." "..suffix,TextColor3=C.purple,
				TextXAlignment=Enum.TextXAlignment.Right,Font=Enum.Font.GothamBold,TextSize=11,ZIndex=4,Parent=row})
			local trackBg=newInst("Frame",{Size=UDim2.new(1,-22,0,4),Position=UDim2.new(0,11,0,44),
				BackgroundColor3=Color3.fromRGB(30,20,50),BorderSizePixel=0,ZIndex=4,Parent=row});corner(99,trackBg)
			local fill=newInst("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=C.purple,
				BorderSizePixel=0,ZIndex=5,Parent=trackBg});corner(99,fill)
			local knob=newInst("Frame",{Size=UDim2.new(0,16,0,16),Position=UDim2.new(0,0,0.5,-8),
				BackgroundColor3=C.purple,BorderSizePixel=0,ZIndex=6,Parent=trackBg})
			corner(99,knob);stroke(C.bgDeep,2,knob)
			local function setSlider(v)
				v=math.clamp(math.round(v/inc)*inc,range[1],range[2]);cur=v
				if cfg2.Flag then flags[cfg2.Flag]=v end
				local pct=(v-range[1])/(range[2]-range[1])
				fill.Size=UDim2.new(pct,0,1,0);knob.Position=UDim2.new(pct,-8,0.5,-8)
				valLbl.Text=tostring(v).." "..suffix
				if cfg2.Callback then cfg2.Callback(v) end
				if sendNotif then notify(cfg2.Name or "Slider",tostring(v).." "..suffix,C.purple) end
				triggerAutoSave()
			end
			setSlider(cur)
			local sliding=false
			trackBg.InputBegan:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					sliding=true;spring(knob,{Size=UDim2.new(0,20,0,20)},0.15)
				end
			end)
			input.InputEnded:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					sliding=false;spring(knob,{Size=UDim2.new(0,16,0,16)},0.15)
				end
			end)
			input.InputChanged:Connect(function(i)
				if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
					local rel=(i.Position.X-trackBg.AbsolutePosition.X)/trackBg.AbsoluteSize.X
					setSlider(range[1]+(range[2]-range[1])*math.clamp(rel,0,1))
				end
			end)
			if cfg2.Flag then table.insert(saveItems,{flag=cfg2.Flag,setter=function(v) setSlider(tonumber(v) or cur) end}) end
			local obj={};function obj:Set(v) setSlider(v) end;function obj:Get() return cur end;return obj
		end

		-- Dropdown
		function tabObj:CreateDropdown(cfg2)
			cfg2=cfg2 or {}
			local options=cfg2.Options or {}
			local multiSel=cfg2.MultipleOptions or false
			local selected=multiSel and {} or (cfg2.CurrentOption or options[1] or "")
			local sendNotif=cfg2.SendNotification~=false
			if cfg2.Flag then flags[cfg2.Flag]=selected end
			local open=false
			local row=makeRow(nil,true);padding(10,10,10,10,row);listLayout(row,6)
			table.insert(allElements,{frame=row,name=cfg2.Name or "Dropdown"})
			local topLine=newInst("Frame",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,ZIndex=4,Parent=row})
			newInst("TextLabel",{Size=UDim2.new(0.6,0,1,0),BackgroundTransparency=1,
				Text=cfg2.Name or "Dropdown",TextColor3=C.textMain,
				TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham,TextSize=12,ZIndex=4,Parent=topLine})
			local function displayText()
				if multiSel then if #selected==0 then return "None  ▾" end;return table.concat(selected,", ").."  ▾"
				else return tostring(selected).."  ▾" end
			end
			local dropBtn=newInst("TextButton",{Size=UDim2.new(1,0,0,30),BackgroundColor3=Color3.fromRGB(26,14,46),
				BorderSizePixel=0,Text=displayText(),TextColor3=C.textLight,
				Font=Enum.Font.Gotham,TextSize=11,ZIndex=4,Parent=row});corner(8,dropBtn);stroke(C.border,1,dropBtn)
			local menuFrame=newInst("Frame",{Size=UDim2.new(1,0,0,0),BackgroundColor3=Color3.fromRGB(19,16,38),
				BorderSizePixel=0,ZIndex=5,ClipsDescendants=true,Visible=false,Parent=row})
			corner(8,menuFrame);stroke(C.border,1,menuFrame);listLayout(menuFrame,0)
			local optBtns={}
			local function isSelected(opt)
				if multiSel then for _,v in ipairs(selected) do if v==opt then return true end end;return false
				else return selected==opt end
			end
			local function refreshColors()
				for opt,ob in pairs(optBtns) do tw(ob,{TextColor3=isSelected(opt) and C.purple or C.textLight},0.1) end
			end
			local function buildOptions()
				for _,c in pairs(menuFrame:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
				optBtns={}
				for _,opt in ipairs(options) do
					local ob=newInst("TextButton",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,
						Text=opt,TextColor3=isSelected(opt) and C.purple or C.textLight,
						Font=Enum.Font.Gotham,TextSize=11,ZIndex=6,Parent=menuFrame})
					optBtns[opt]=ob
					ob.MouseButton1Click:Connect(function()
						if multiSel then
							local found=false
							for i,v in ipairs(selected) do if v==opt then table.remove(selected,i);found=true;break end end
							if not found then table.insert(selected,opt) end
							refreshColors();dropBtn.Text=displayText()
							if cfg2.Flag then flags[cfg2.Flag]=selected end
							if cfg2.Callback then cfg2.Callback(selected) end
							if sendNotif then notify(cfg2.Name or "Dropdown","Selected: "..displayText():gsub("  ▾",""),C.purple) end
						else
							selected=opt;dropBtn.Text=opt.."  ▾";open=false
							tw(menuFrame,{Size=UDim2.new(1,0,0,0)},0.18,Enum.EasingStyle.Quad)
							task.delay(0.2,function() menuFrame.Visible=false end)
							if cfg2.Flag then flags[cfg2.Flag]=opt end
							if cfg2.Callback then cfg2.Callback(opt) end
							if sendNotif then notify(cfg2.Name or "Dropdown","Selected: "..opt,C.purple) end
						end
						triggerAutoSave()
					end)
					ob.MouseEnter:Connect(function() tw(ob,{BackgroundTransparency=0.7,BackgroundColor3=C.purpleFade},0.1) end)
					ob.MouseLeave:Connect(function() tw(ob,{BackgroundTransparency=1},0.1) end)
				end
			end
			buildOptions()
			dropBtn.MouseButton1Click:Connect(function()
				open=not open
				if open then
					menuFrame.Visible=true;menuFrame.Size=UDim2.new(1,0,0,0)
					spring(menuFrame,{Size=UDim2.new(1,0,0,#options*30)},0.3)
					dropBtn.Text=displayText():gsub("▾$","▴")
				else
					tw(menuFrame,{Size=UDim2.new(1,0,0,0)},0.18,Enum.EasingStyle.Quad)
					task.delay(0.2,function() menuFrame.Visible=false end)
					dropBtn.Text=displayText()
				end
			end)
			if cfg2.Flag then
				table.insert(saveItems,{flag=cfg2.Flag,setter=function(v)
					selected=v;if cfg2.Flag then flags[cfg2.Flag]=v end
					dropBtn.Text=displayText();refreshColors()
				end})
			end
			local obj={}
			function obj:Set(v) selected=v;if cfg2.Flag then flags[cfg2.Flag]=v end;dropBtn.Text=displayText();refreshColors() end
			function obj:Refresh(newOpts)
				options=newOpts
				if multiSel then selected={} else selected=newOpts[1] or "" end
				dropBtn.Text=displayText()
				if open then menuFrame.Visible=false;open=false end
				buildOptions()
			end
			function obj:Get() return selected end
			return obj
		end


			displayNameLbl.Text=me.DisplayName;usernameLbl.Text="@"..me.Name;userIdLbl.Text=tostring(me.UserId)
			tw(anonThumb,{Position=UDim2.new(0,2,0.5,-7),BackgroundColor3=C.purpleFade},0.18)
			tw(anonTrack,{BackgroundColor3=Color3.fromRGB(26,26,46)},0.18)
		end
	end)

	local PANEL_H = 274

	local function openPanel()
		panelOpen=true;panel.Visible=true
		panel.BackgroundTransparency=1;panel.Size=UDim2.new(0,260,0,0)
		spring(panel,{Size=UDim2.new(0,260,0,PANEL_H),BackgroundTransparency=0},0.4)
	end
	local function closePanel()
		panelOpen=false
		tw(panel,{Size=UDim2.new(0,260,0,0),BackgroundTransparency=1},0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
		task.delay(0.25,function() if not panelOpen then panel.Visible=false end end)
	end
	return {open=openPanel,close=closePanel,isOpen=function() return panelOpen end}
end


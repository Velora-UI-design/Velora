local function flashButton(btn,success)
	local s=btn:FindFirstChildWhichIsA("UIStroke")
	tw(btn,{BackgroundColor3=success and Color3.fromRGB(30,80,30) or Color3.fromRGB(85,0,0)},0.1)
	if s then tw(s,{Color=success and C.green or C.red,Thickness=2},0.1) end
	task.delay(0.5,function()
		if not btn.Parent then return end
		tw(btn,{BackgroundColor3=Color3.fromRGB(26,14,46)},0.4,Enum.EasingStyle.Quad)
		if s then tw(s,{Color=C.border,Thickness=1},0.4) end
	end)
end


	local isMobile=input.TouchEnabled and not input.KeyboardEnabled

	-- reveals window after key check (or immediately if no key)
	local function revealWindow()
		win.Visible=true;glowFrame.Visible=true
		showLoadingScreen(screen,cfg)
		task.defer(function()
			spring(win,{Size=UDim2.new(0,440,0,490),BackgroundTransparency=0,
				Position=UDim2.new(0.5,-220,0.5,-245)},0.4)
		end)
		if not isMobile then
			task.delay(2.4,function()
				notify("Velora UI","Press "..tostring(toggleKey.Name).." to toggle",C.purple)
			end)
			input.InputBegan:Connect(function(i,gp)
				if gp then return end
				if i.KeyCode==toggleKey then win.Visible=not win.Visible;glowFrame.Visible=win.Visible end
			end)
		end
	end

	-- gate: show key system first, then reveal
	if useKey then
		showKeySystem(screen,keyCfg,revealWindow)
	else
		revealWindow()
	end


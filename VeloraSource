		BackgroundColor3 = Color3.fromRGB(12, 10, 24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 201, Parent = overlay,
	}); corner(18, inner); stroke(C.border, 1.2, inner)

	local logoFrame = newInst("Frame", {
		Size = UDim2.new(0, 64, 0, 64), Position = UDim2.new(0, 28, 0.5, -32),
		BackgroundColor3 = Color3.fromRGB(20, 14, 38),
		BorderSizePixel = 0, ZIndex = 202, Parent = inner,
	}); corner(14, logoFrame); stroke(C.border, 1, logoFrame)

	newInst("ImageLabel", {
		Size = UDim2.new(0, 48, 0, 48), Position = UDim2.new(0.5, -24, 0.5, -24),
		BackgroundTransparency = 1, Image = logoId,
		ZIndex = 203, Parent = logoFrame,
	})

	local tx = 108
	newInst("TextLabel", {
		Size = UDim2.new(1, -(tx + 18), 0, 28), Position = UDim2.new(0, tx, 0, 32),
		BackgroundTransparency = 1, Text = loadTitle,
		TextColor3 = C.purple, Font = Enum.Font.GothamBold,
		TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 202, Parent = inner,
	})
	newInst("TextLabel", {
		Size = UDim2.new(1, -(tx + 18), 0, 18), Position = UDim2.new(0, tx, 0, 62),
		BackgroundTransparency = 1, Text = loadSubtitle,
		TextColor3 = C.textDim, Font = Enum.Font.Gotham,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 202, Parent = inner,
	})

	local barTrack = newInst("Frame", {
		Size = UDim2.new(1, -56, 0, 4), Position = UDim2.new(0, 28, 1, -24),
		BackgroundColor3 = Color3.fromRGB(26, 20, 46),
		BorderSizePixel = 0, ZIndex = 202, Parent = inner,
	}); corner(99, barTrack)

	local barFill = newInst("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.purple,
		BorderSizePixel = 0, ZIndex = 203, Parent = barTrack,
	}); corner(99, barFill)

	local loadLbl = newInst("TextLabel", {
		Size = UDim2.new(1, -56, 0, 14), Position = UDim2.new(0, 28, 1, -44),
		BackgroundTransparency = 1, Text = "Loading...",
		TextColor3 = C.textDim, Font = Enum.Font.Gotham,
		TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 202, Parent = inner,
	})

	tween:Create(inner, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0,
		Position = UDim2.new(0.5, -160, 0.5, -80),
	}):Play()

	task.spawn(function()
		local steps = { "Initializing...", "Loading UI...", "Applying theme...", "Ready!" }
		for i, msg in ipairs(steps) do
			loadLbl.Text = msg
			tween:Create(barFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(i / #steps, 0, 1, 0)
			}):Play()
			task.wait(0.38)
		end
	end)

	task.delay(1.85, function()
		tween:Create(overlay, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			BackgroundTransparency = 1
		}):Play()
		tween:Create(inner, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, -160, 0.4, -80),
		}):Play()
		task.delay(0.55, function() if overlay.Parent then overlay:Destroy() end end)
	end)
end

-- ─── CreateWindow ─────────────────────────────────────────────────────────────

function VeloraUI:CreateWindow(cfg)
	cfg = cfg or {}
	local me        = game.Players.LocalPlayer
	local title     = cfg.Name or "Velora UI"
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightBracket
	local useKey    = cfg.KeySystem == true
	local keyCfg    = cfg.KeySettings or {}

	if me.PlayerGui:FindFirstChild("VeloraUI") then
		me.PlayerGui.VeloraUI:Destroy()
	end

	local screen = newInst("ScreenGui", {
		Name = "VeloraUI", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = me.PlayerGui,
	})

	screen.AncestryChanged:Connect(function()
		if not screen.Parent then
			_G.__VeloraUI_Running = nil
		end
	end)

	local notify = buildNotifSystem(screen)

	-- ── glow + window (built immediately, hidden until key passes) ────────────
	local glowFrame = newInst("Frame", {
		Size = UDim2.new(0, 458, 0, 510), Position = UDim2.new(0.5, -229, 0.5, -255),
		BackgroundColor3 = Color3.fromRGB(100, 50, 220), BackgroundTransparency = 0.88,
		BorderSizePixel = 0, ZIndex = 0, Visible = false, Parent = screen,
	}); corner(20, glowFrame)

	local win = newInst("Frame", {
		Size = UDim2.new(0, 370, 0, 420), Position = UDim2.new(0.5, -220, 0.5, -245),
		BackgroundColor3 = C.bg, BorderSizePixel = 0, ZIndex = 1,
		ClipsDescendants = false, BackgroundTransparency = 1,
		Visible = false, Parent = screen,
	}); corner(16, win); stroke(Color3.fromRGB(100, 50, 220), 1.5, win)

	-- topbar
	local topbar = newInst("Frame", {
		Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = C.bgDeep,
		BorderSizePixel = 0, ZIndex = 2, Parent = win,
	}); corner(16, topbar)
	newInst("Frame", {
		Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16),
		BackgroundColor3 = C.bgDeep, BorderSizePixel = 0, ZIndex = 2, Parent = topbar,
	})

	local dotRed = newInst("TextButton", {
		Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 14, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(255, 95, 87), BorderSizePixel = 0,
		Text = "", ZIndex = 4, Parent = topbar,
	}); corner(99, dotRed)

	local dotYellow = newInst("TextButton", {
		Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 32, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(255, 189, 46), BorderSizePixel = 0,
		Text = "", ZIndex = 4, Parent = topbar,
	}); corner(99, dotYellow)

	local dotGreen = newInst("Frame", {
		Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 50, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(40, 202, 65), BorderSizePixel = 0,
		ZIndex = 4, Parent = topbar,
	}); corner(99, dotGreen)

	newInst("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Text = title, TextColor3 = C.purple, TextScaled = true,
		Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3, Parent = topbar,
	})

	-- drag (global listeners so fast movement doesn't lose tracking)
	local dragging, dragStart, startPos = false, nil, nil
	topbar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = i.Position; startPos = win.Position
		end
	end)
	input.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			glowFrame.Position = UDim2.new(win.Position.X.Scale, win.Position.X.Offset - 9, win.Position.Y.Scale, win.Position.Y.Offset - 9)
		end
	end)
	input.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- tab bar
	local tabBar = newInst("Frame", {
		Size = UDim2.new(1, 0, 0, 38), Position = UDim2.new(0, 0, 0, 44),
		BackgroundColor3 = C.bgDeep, BorderSizePixel = 0, ZIndex = 2, Parent = win,
	}); stroke(Color3.fromRGB(100, 50, 220), 1, tabBar)
	listLayout(tabBar, 0, Enum.FillDirection.Horizontal)

	-- body
	local bodyFrame = newInst("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -104), Position = UDim2.new(0, 0, 0, 82),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 2, ScrollBarImageColor3 = C.border,
		CanvasSize = UDim2.new(0, 0, 0, 0), ZIndex = 2,
		ClipsDescendants = true, Parent = win,
	}); padding(8, 8, 8, 8, bodyFrame)

	local bodyLayout = listLayout(bodyFrame, 6)
	bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		bodyFrame.CanvasSize = UDim2.new(0, 0, 0, bodyLayout.AbsoluteContentSize.Y + 16)
	end)

	-- minimize
	local minimized = false
	dotYellow.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			bodyFrame.Visible = false; tabBar.Visible = false
			tween:Create(win, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 440, 0, 44) }):Play()
			tween:Create(glowFrame, TweenInfo.new(0.3), { Size = UDim2.new(0, 458, 0, 60) }):Play()
		else
			bodyFrame.Visible = true; tabBar.Visible = true
			tween:Create(win, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 440, 0, 490) }):Play()
			tween:Create(glowFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 458, 0, 510) }):Play()
		end
	end)

	-- close with confirm dialog
	dotRed.MouseButton1Click:Connect(function()
		buildConfirmDialog(screen,
			function()
				tween:Create(win, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Size = UDim2.new(0, 300, 0, 0), BackgroundTransparency = 1 }):Play()
				tween:Create(glowFrame, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
				task.delay(0.3, function()
					_G.__VeloraUI_Running = nil
					screen:Destroy()
				end)
			end,
			nil
		)
	end)

	-- keyboard toggle
	local isMobile = input.TouchEnabled and not input.KeyboardEnabled

	-- ── Function that actually reveals the window ─────────────────────────────
	local function revealWindow()
		win.Visible = true
		glowFrame.Visible = true
		showLoadingScreen(screen, cfg)

		task.defer(function()
			tween:Create(win, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 440, 0, 490), BackgroundTransparency = 0,
				Position = UDim2.new(0.5, -220, 0.5, -245),
			}):Play()
		end)

		if not isMobile then
			task.delay(2.4, function()
				notify("Velora UI", "Press " .. tostring(toggleKey.Name) .. " to toggle", C.purple)
			end)
			input.InputBegan:Connect(function(i, gp)
				if gp then return end
				if i.KeyCode == toggleKey then
					win.Visible = not win.Visible; glowFrame.Visible = win.Visible
				end
			end)
		end
	end

	-- ── Key system gate ───────────────────────────────────────────────────────
	if useKey then
		showKeySystem(screen, keyCfg, revealWindow)
	else
		revealWindow()
	end

	local tabCount = 0; local activeTab = nil
	local winObj = {}

	-- ─── CreateTab ────────────────────────────────────────────────────────────

	function winObj:CreateTab(tabName)
		tabCount = tabCount + 1

		local tabBtn = newInst("TextButton", {
			Size = UDim2.new(0, 100, 1, 0), BackgroundColor3 = C.bgDeep,
			BorderSizePixel = 0, Text = tabName, TextColor3 = C.textDim,
			Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 3, Parent = tabBar,
		})
		local underline = newInst("Frame", {
			Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
			BackgroundColor3 = C.border, BorderSizePixel = 0,
			BackgroundTransparency = 1, ZIndex = 4, Parent = tabBtn,
		})

		local tabContainer = newInst("Frame", {
			Size = UDim2.new(1, 0, 0, 10),
			BackgroundTransparency = 1, BorderSizePixel = 0,
			Visible = false, ZIndex = 2,
			AutomaticSize = Enum.AutomaticSize.Y,
			ClipsDescendants = false, Parent = bodyFrame,
		})
		listLayout(tabContainer, 6)

		local entry = { container = tabContainer, btn = tabBtn, line = underline }
		local function activate()
			if activeTab then
				activeTab.container.Visible = false
				tween:Create(activeTab.btn, TweenInfo.new(0.15), { TextColor3 = C.textDim }):Play()
				tween:Create(activeTab.line, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
			end
			activeTab = entry; tabContainer.Visible = true
			tween:Create(tabBtn, TweenInfo.new(0.15), { TextColor3 = C.textMain }):Play()
			tween:Create(underline, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
		end
		if tabCount == 1 then activate() end
		tabBtn.MouseButton1Click:Connect(activate)

		local tabObj = {}

		local function makeRow(h, autoY)
			local r = newInst("Frame", {
				Size = autoY and UDim2.new(1, 0, 0, 10) or UDim2.new(1, 0, 0, h or 48),
				BackgroundColor3 = C.bgRow, BorderSizePixel = 0, ZIndex = 3,
				ClipsDescendants = false,
				AutomaticSize = autoY and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
				Parent = tabContainer,
			}); corner(10, r); stroke(Color3.fromRGB(100, 50, 220), 1, r); return r
		end

		local function rowLabel(txt, sub, parent)
			local wrap = newInst("Frame", {
				Size = UDim2.new(0.6, 0, 0, sub and 38 or 22),
				Position = UDim2.new(0, 12, 0.5, sub and -19 or -11),
				BackgroundTransparency = 1, ZIndex = 4, Parent = parent,
			})
			newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
				Text = txt, TextColor3 = C.textMain,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 4, Parent = wrap,
			})
			if sub then
				newInst("TextLabel", {
					Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 19),
					BackgroundTransparency = 1, Text = sub, TextColor3 = C.textDim,
					TextXAlignment = Enum.TextXAlignment.Left,
					Font = Enum.Font.Gotham, TextSize = 10, ZIndex = 4, Parent = wrap,
				})
			end
		end

		-- ── Toggle ────────────────────────────────────────────────────────────

		function tabObj:CreateToggle(cfg2)
			cfg2 = cfg2 or {}
			local val = cfg2.CurrentValue or false
			local sendNotif = cfg2.SendNotification ~= false
			if cfg2.Flag then flags[cfg2.Flag] = val end

			local row = makeRow(48); rowLabel(cfg2.Name or "Toggle", cfg2.Description, row)

			local track = newInst("Frame", {
				Size = UDim2.new(0, 42, 0, 24), Position = UDim2.new(1, -54, 0.5, -12),
				BackgroundColor3 = Color3.fromRGB(26, 26, 46), BorderSizePixel = 0, ZIndex = 4, Parent = row,
			}); corner(99, track); stroke(Color3.fromRGB(100, 50, 220), 1, track)
			local thumb = newInst("Frame", {
				Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 2, 0.5, -9),
				BackgroundColor3 = C.purpleFade, BorderSizePixel = 0, ZIndex = 5, Parent = track,
			}); corner(99, thumb)

			local function setVal(v)
				val = v
				if cfg2.Flag then flags[cfg2.Flag] = v end
				if v then
					tween:Create(thumb, TweenInfo.new(0.18), { Position = UDim2.new(0, 22, 0.5, -9), BackgroundColor3 = C.purple }):Play()
					tween:Create(track, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(42, 26, 78) }):Play()
				else
					tween:Create(thumb, TweenInfo.new(0.18), { Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = C.purpleFade }):Play()
					tween:Create(track, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(26, 26, 46) }):Play()
				end
				if cfg2.Callback then cfg2.Callback(v) end
				if sendNotif then
					notify(cfg2.Name or "Toggle", v and "Enabled" or "Disabled", v and C.green or C.red)
				end
			end

			setVal(val)
			track.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					setVal(not val)
				end
			end)

			if cfg2.Flag then
				table.insert(saveItems, { flag = cfg2.Flag, setter = function(v) setVal(v == true or v == "true") end })
			end

			local obj = {}
			function obj:Set(v) setVal(v) end
			function obj:Get() return val end
			return obj
		end

		-- ── Button ────────────────────────────────────────────────────────────

		function tabObj:CreateButton(cfg2)
			cfg2 = cfg2 or {}
			local sendNotif = cfg2.SendNotification ~= false
			local row = makeRow(48); rowLabel(cfg2.Name or "Button", cfg2.Description, row)

			local btn2 = newInst("TextButton", {
				Size = UDim2.new(0, 66, 0, 30), Position = UDim2.new(1, -78, 0.5, -15),
				BackgroundColor3 = Color3.fromRGB(26, 14, 46), BorderSizePixel = 0,
				Text = cfg2.ButtonText or "Run",
				TextColor3 = cfg2.Danger and C.red or C.purple,
				Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 4, Parent = row,
			}); corner(8, btn2)
			stroke(cfg2.Danger and Color3.fromRGB(160, 48, 48) or C.border, 1, btn2)

			btn2.MouseButton1Click:Connect(function()
				tween:Create(btn2, TweenInfo.new(0.07), { Size = UDim2.new(0, 58, 0, 26), Position = UDim2.new(1, -74, 0.5, -13) }):Play()
				task.delay(0.07, function()
					tween:Create(btn2, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Size = UDim2.new(0, 66, 0, 30), Position = UDim2.new(1, -78, 0.5, -15) }):Play()
				end)
				if cfg2.Callback then cfg2.Callback() end
				if sendNotif then
					notify(cfg2.Name or "Button", cfg2.NotifContent or "Button pressed", cfg2.Danger and C.red or C.purple)
				end
			end)

			local obj = {}
			function obj:Set(txt) btn2.Text = tostring(txt) end
			return obj
		end

		-- ── Slider ────────────────────────────────────────────────────────────

		function tabObj:CreateSlider(cfg2)
			cfg2 = cfg2 or {}
			local range = cfg2.Range or { 0, 100 }
			local inc = cfg2.Increment or 1
			local suffix = cfg2.Suffix or ""
			local cur = cfg2.CurrentValue or range[1]
			local sendNotif = cfg2.SendNotification == true
			if cfg2.Flag then flags[cfg2.Flag] = cur end

			local row = makeRow(64); rowLabel(cfg2.Name or "Slider", nil, row)

			local valLbl = newInst("TextLabel", {
				Size = UDim2.new(0, 80, 0, 18), Position = UDim2.new(1, -88, 0, 14),
				BackgroundTransparency = 1, Text = tostring(cur) .. " " .. suffix,
				TextColor3 = C.purple, TextXAlignment = Enum.TextXAlignment.Right,
				Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 4, Parent = row,
			})
			local trackBg = newInst("Frame", {
				Size = UDim2.new(1, -22, 0, 4), Position = UDim2.new(0, 11, 0, 44),
				BackgroundColor3 = Color3.fromRGB(30, 20, 50), BorderSizePixel = 0, ZIndex = 4, Parent = row,
			}); corner(99, trackBg)
			local fill = newInst("Frame", {
				Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.purple,
				BorderSizePixel = 0, ZIndex = 5, Parent = trackBg,
			}); corner(99, fill)
			local knob = newInst("Frame", {
				Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 0, 0.5, -8),
				BackgroundColor3 = C.purple, BorderSizePixel = 0, ZIndex = 6, Parent = trackBg,
			}); corner(99, knob); stroke(C.bgDeep, 2, knob)

			local function setSlider(v)
				v = math.clamp(math.round(v / inc) * inc, range[1], range[2]); cur = v
				if cfg2.Flag then flags[cfg2.Flag] = v end
				local pct = (v - range[1]) / (range[2] - range[1])
				fill.Size = UDim2.new(pct, 0, 1, 0); knob.Position = UDim2.new(pct, -8, 0.5, -8)
				valLbl.Text = tostring(v) .. " " .. suffix
				if cfg2.Callback then cfg2.Callback(v) end
				if sendNotif then notify(cfg2.Name or "Slider", tostring(v) .. " " .. suffix, C.purple) end
			end
			setSlider(cur)

			local sliding = false
			trackBg.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end)
			input.InputEnded:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)
			input.InputChanged:Connect(function(i)
				if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
					local rel = (i.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X
					setSlider(range[1] + (range[2] - range[1]) * math.clamp(rel, 0, 1))
				end
			end)

			if cfg2.Flag then
				table.insert(saveItems, { flag = cfg2.Flag, setter = function(v) setSlider(tonumber(v) or cur) end })
			end

			local obj = {}
			function obj:Set(v) setSlider(v) end
			function obj:Get() return cur end
			return obj
		end

		-- ── Dropdown ──────────────────────────────────────────────────────────

		function tabObj:CreateDropdown(cfg2)
			cfg2 = cfg2 or {}
			local options = cfg2.Options or {}
			local multiSel = cfg2.MultipleOptions or false
			local selected = multiSel and {} or (cfg2.CurrentOption or options[1] or "")
			local sendNotif = cfg2.SendNotification ~= false
			if cfg2.Flag then flags[cfg2.Flag] = selected end
			local open = false

			local row = makeRow(nil, true); padding(10, 10, 10, 10, row); listLayout(row, 6)

			local topLine = newInst("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, ZIndex = 4, Parent = row })
			newInst("TextLabel", {
				Size = UDim2.new(0.6, 0, 1, 0), BackgroundTransparency = 1,
				Text = cfg2.Name or "Dropdown", TextColor3 = C.textMain,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 4, Parent = topLine,
			})

			local function displayText()
				if multiSel then
					if #selected == 0 then return "None  v" end
					return table.concat(selected, ", ") .. "  v"
				else return tostring(selected) .. "  v" end
			end

			local dropBtn = newInst("TextButton", {
				Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(26, 14, 46),
				BorderSizePixel = 0, Text = displayText(), TextColor3 = C.purple,
				Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 4, Parent = row,
			}); corner(8, dropBtn); stroke(C.border, 1, dropBtn)

			local menuFrame = newInst("Frame", {
				Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(19, 16, 38),
				BorderSizePixel = 0, ZIndex = 5, ClipsDescendants = true,
				Visible = false, Parent = row,
			}); corner(8, menuFrame); stroke(C.border, 1, menuFrame); listLayout(menuFrame, 0)

			local optBtns = {}

			local function isSelected(opt)
				if multiSel then
					for _, v in ipairs(selected) do if v == opt then return true end end
					return false
				else return selected == opt end
			end
			local function refreshColors()
				for opt, ob in pairs(optBtns) do
					tween:Create(ob, TweenInfo.new(0.1), { TextColor3 = isSelected(opt) and C.purple or C.textDim }):Play()
				end
			end
			local function buildOptions()
				for _, c in pairs(menuFrame:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
				optBtns = {}
				for _, opt in ipairs(options) do
					local ob = newInst("TextButton", {
						Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
						Text = opt, TextColor3 = isSelected(opt) and C.purple or C.textDim,
						Font = Enum.Font.Gotham, TextSize = 11, ZIndex = 6, Parent = menuFrame,
					})
					optBtns[opt] = ob
					ob.MouseButton1Click:Connect(function()
						if multiSel then
							local found = false
							for i, v in ipairs(selected) do if v == opt then table.remove(selected, i); found = true; break end end
							if not found then table.insert(selected, opt) end
							refreshColors(); dropBtn.Text = displayText()
							if cfg2.Flag then flags[cfg2.Flag] = selected end
							if cfg2.Callback then cfg2.Callback(selected) end
							if sendNotif then notify(cfg2.Name or "Dropdown", "Selected: " .. displayText():gsub("  v", ""), C.purple) end
						else
							selected = opt; dropBtn.Text = opt .. "  v"; open = false
							tween:Create(menuFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0, 0) }):Play()
							task.delay(0.2, function() menuFrame.Visible = false end)
							if cfg2.Flag then flags[cfg2.Flag] = opt end
							if cfg2.Callback then cfg2.Callback(opt) end
							if sendNotif then notify(cfg2.Name or "Dropdown", "Selected: " .. opt, C.purple) end
						end
					end)
					ob.MouseEnter:Connect(function()
						tween:Create(ob, TweenInfo.new(0.1), { BackgroundTransparency = 0.7, BackgroundColor3 = C.purpleFade }):Play()
					end)
					ob.MouseLeave:Connect(function()
						tween:Create(ob, TweenInfo.new(0.1), { BackgroundTransparency = 1 }):Play()
					end)
				end
			end
			buildOptions()

			dropBtn.MouseButton1Click:Connect(function()
				open = not open
				if open then
					menuFrame.Visible = true; menuFrame.Size = UDim2.new(1, 0, 0, 0)
					tween:Create(menuFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
						Size = UDim2.new(1, 0, 0, #options * 30)
					}):Play()
					dropBtn.Text = displayText():gsub("v$", "^")
				else
					tween:Create(menuFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0, 0) }):Play()
					task.delay(0.2, function() menuFrame.Visible = false end)
					dropBtn.Text = displayText()
				end
			end)

			if cfg2.Flag then
				table.insert(saveItems, { flag = cfg2.Flag, setter = function(v)
					selected = v
					if cfg2.Flag then flags[cfg2.Flag] = v end
					dropBtn.Text = displayText(); refreshColors()
				end })
			end

			local obj = {}
			function obj:Set(v) selected = v; if cfg2.Flag then flags[cfg2.Flag] = v end; dropBtn.Text = displayText(); refreshColors() end
			function obj:Refresh(newOpts)
				options = newOpts
				if multiSel then selected = {} else selected = newOpts[1] or "" end
				dropBtn.Text = displayText()
				if open then menuFrame.Visible = false; open = false end
				buildOptions()
			end
			function obj:Get() return selected end
			return obj
		end

		-- ── Input ─────────────────────────────────────────────────────────────

		function tabObj:CreateInput(cfg2)
			cfg2 = cfg2 or {}
			local val = cfg2.CurrentValue or ""
			if cfg2.Flag then flags[cfg2.Flag] = val end

			local row = makeRow(nil, true); padding(10, 10, 10, 10, row); listLayout(row, 6)
			local topLine = newInst("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, ZIndex = 4, Parent = row })
			newInst("TextLabel", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
				Text = cfg2.Name or "Input", TextColor3 = C.textMain,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 4, Parent = topLine,
			})
			local box = newInst("TextBox", {
				Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.inputBg,
				BorderSizePixel = 0, Text = val,
				PlaceholderText = cfg2.PlaceholderText or "Type here...",
				PlaceholderColor3 = C.textDim, TextColor3 = C.purple,
				Font = Enum.Font.Gotham, TextSize = 11, ZIndex = 4,
				ClearTextOnFocus = false, Parent = row,
			}); corner(8, box); stroke(C.border, 1, box); padding(0, 0, 8, 8, box)

			box:GetPropertyChangedSignal("Text"):Connect(function()
				val = box.Text
				if cfg2.Flag then flags[cfg2.Flag] = val end
				if cfg2.Callback then cfg2.Callback(val) end
			end)
			if cfg2.RemoveTextAfterFocusLost then
				box.FocusLost:Connect(function() box.Text = ""; val = ""; if cfg2.Flag then flags[cfg2.Flag] = "" end end)
			end

			if cfg2.Flag then
				table.insert(saveItems, { flag = cfg2.Flag, setter = function(v)
					box.Text = tostring(v); val = tostring(v)
					if cfg2.Flag then flags[cfg2.Flag] = val end
				end })
			end

			local obj = {}
			function obj:Set(v) box.Text = tostring(v); val = tostring(v); if cfg2.Flag then flags[cfg2.Flag] = val end end
			function obj:Get() return val end
			return obj
		end

		-- ── Label ─────────────────────────────────────────────────────────────

		function tabObj:CreateLabel(txt, _icon, col, _ignoreTheme)
			col = col or C.textMain
			local lbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
				Text = tostring(txt), TextColor3 = col,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 3, Parent = tabContainer,
			}); padding(0, 0, 6, 0, lbl)
			local obj = {}
			function obj:Set(newTxt, _i, newCol)
				lbl.Text = tostring(newTxt)
				if newCol then lbl.TextColor3 = newCol end
			end
			return obj
		end

		-- ── Paragraph ─────────────────────────────────────────────────────────

		function tabObj:CreateParagraph(cfg2)
			cfg2 = cfg2 or {}
			local row = makeRow(nil, true); padding(10, 10, 12, 12, row); listLayout(row, 4)
			local titleLbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
				Text = cfg2.Title or "", TextColor3 = C.textMain,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 4, Parent = row,
			})
			local contentLbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
				Text = cfg2.Content or "", TextColor3 = C.textDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true, Font = Enum.Font.Gotham, TextSize = 11,
				AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 4, Parent = row,
			})
			local obj = {}
			function obj:Set(newCfg)
				if newCfg.Title then titleLbl.Text = newCfg.Title end
				if newCfg.Content then contentLbl.Text = newCfg.Content end
			end
			return obj
		end

		-- ── SectionLabel ──────────────────────────────────────────────────────

		function tabObj:CreateSectionLabel(txt)
			local lbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
				Text = txt, TextColor3 = C.textDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, TextSize = 9, ZIndex = 3, Parent = tabContainer,
			}); padding(0, 0, 6, 0, lbl)
		end

		return tabObj
	end

	-- ── Window-level methods ───────────────────────────────────────────────────

	function winObj:GetFlag(flag) return flags[flag] end

	function winObj:Notify(title2, content2, col2)
		if typeof(content2) == "Color3" then col2 = content2; content2 = "" end
		notify(tostring(title2 or "Notification"), tostring(content2 or ""), col2 or C.purple)
	end

	function winObj:SaveConfiguration()
		local ok = saveConfig()
		notify("Config", ok and "Saved successfully!" or "Save failed!", ok and C.green or C.red)
		return ok
	end

	function winObj:LoadConfiguration()
		local data = loadConfig()
		if not data then
			notify("Config", "No save file found", C.red)
			return false
		end
		for _, item in ipairs(saveItems) do
			local v = data[item.flag]
			if v ~= nil then pcall(item.setter, v) end
		end
		notify("Config", "Loaded successfully!", C.green)
		return true
	end

	return winObj
end

return VeloraUI

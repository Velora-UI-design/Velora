				box.FocusLost:Connect(function() box.Text="";val="";if cfg2.Flag then flags[cfg2.Flag]="" end end)
			end
			if cfg2.Flag then
				table.insert(saveItems,{flag=cfg2.Flag,setter=function(v)
					box.Text=tostring(v);val=tostring(v);if cfg2.Flag then flags[cfg2.Flag]=val end
				end})
			end
			local obj={}
			function obj:Set(v) box.Text=tostring(v);val=tostring(v);if cfg2.Flag then flags[cfg2.Flag]=val end end
			function obj:Get() return val end
			return obj
		end

		-- Label
		function tabObj:CreateLabel(txt,_icon,col)
			col=col or C.textMain
			local lbl=newInst("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,
				Text=tostring(txt),TextColor3=col,TextXAlignment=Enum.TextXAlignment.Left,
				Font=Enum.Font.Gotham,TextSize=11,ZIndex=3,Parent=tabContainer});padding(0,0,6,0,lbl)
			local obj={}
			function obj:Set(newTxt,_i,newCol)
				lbl.Text=tostring(newTxt);if newCol then lbl.TextColor3=newCol end
			end
			return obj
		end

		-- Paragraph
		function tabObj:CreateParagraph(cfg2)
			cfg2=cfg2 or {}
			local row=makeRow(nil,true);padding(10,10,12,12,row);listLayout(row,4)
			table.insert(allElements,{frame=row,name=cfg2.Title or "Paragraph"})
			newInst("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,
				Text=cfg2.Title or "",TextColor3=C.textMain,TextXAlignment=Enum.TextXAlignment.Left,
				Font=Enum.Font.GothamBold,TextSize=12,ZIndex=4,Parent=row})
			local contentLbl=newInst("TextLabel",{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1,
				Text=cfg2.Content or "",TextColor3=C.textDim,TextXAlignment=Enum.TextXAlignment.Left,
				TextWrapped=true,Font=Enum.Font.Gotham,TextSize=11,AutomaticSize=Enum.AutomaticSize.Y,ZIndex=4,Parent=row})
			local obj={}
			function obj:Set(newCfg) if newCfg.Content then contentLbl.Text=newCfg.Content end end
			return obj
		end

		-- SectionLabel
		function tabObj:CreateSectionLabel(txt)
			newInst("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,
				Text=txt,TextColor3=C.textDim,TextXAlignment=Enum.TextXAlignment.Left,
				Font=Enum.Font.GothamBold,TextSize=9,ZIndex=3,Parent=tabContainer})
		end

		return tabObj
	end

	-- ── Window-level methods ───────────────────────────────────────────────────
	function winObj:GetFlag(flag) return flags[flag] end

	function winObj:Notify(title2,content2,col2)
		if typeof(content2)=="Color3" then col2=content2;content2="" end
		notify(tostring(title2 or "Notification"),tostring(content2 or ""),col2 or C.purple)
	end

	function winObj:SaveConfiguration()
		if not configEnabled then notify("Config","Configuration saving not enabled.",C.red);return false end
		local ok=saveConfig()
		notify("Config",ok and "Saved successfully!" or "Save failed!",ok and C.green or C.red)
		return ok
	end

	function winObj:LoadConfiguration()
		if not configEnabled then notify("Config","Configuration saving not enabled.",C.red);return false end
		local data=loadConfig()
		if not data then notify("Config","No save file found",C.red);return false end
		for _,item in ipairs(saveItems) do
			local v=data[item.flag]
			if v~=nil then pcall(item.setter,v) end
		end
		showConfigBanner(win)
		return true
	end

	function winObj:Destroy()
		_G.__VeloraUI_Running=nil;screen:Destroy()
	end

	return winObj
end

return VeloraUI

	-- element registry for search
	local allElements={}
	local function runSearch(query)
		query=query:lower():gsub("^%s*(.-)%s*$","%1")
		for _,entry in ipairs(allElements) do
			if entry.frame and entry.frame.Parent then
				entry.frame.Visible=query=="" or entry.name:lower():find(query,1,true)~=nil
			end
		end
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(function() runSearch(searchBox.Text) end)

	local function openSearch()
		if searchOpen then return end
		searchOpen=true;searchBar.Visible=true
		searchBar.BackgroundTransparency=1;searchBarStroke.Transparency=1;searchGlowFrame.BackgroundTransparency=1
		-- shift body down to make room
		bodyFrame.Size=UDim2.new(1,0,1,-124);bodyFrame.Position=UDim2.new(0,0,0,124)
		spring(searchBar,{BackgroundTransparency=0},0.35)
		tw(searchBarStroke,{Transparency=0},0.25)
		tw(searchGlowFrame,{BackgroundTransparency=0.9},0.3)
		tw(searchIcon,{ImageColor3=C.purple},0.2)
		task.delay(0.1,function() searchBox:CaptureFocus() end)
	end
	local function closeSearch()
		if not searchOpen then return end
		searchOpen=false;searchBox.Text="";runSearch("")
		tw(searchBar,{BackgroundTransparency=1},0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
		tw(searchBarStroke,{Transparency=1},0.2)
		tw(searchGlowFrame,{BackgroundTransparency=1},0.2)
		task.delay(0.22,function() searchBar.Visible=false end)
		bodyFrame.Size=UDim2.new(1,0,1,-82);bodyFrame.Position=UDim2.new(0,0,0,82)
	end

	searchToggleBtn.MouseButton1Click:Connect(function()
		if searchOpen then closeSearch() else openSearch() end
	end)
	searchBox.FocusLost:Connect(function()
		if searchBox.Text=="" and searchOpen then task.wait(0.15);closeSearch() end
	end)
	-- glow pulse while focused
	searchBox.Focused:Connect(function()
		tw(searchBarStroke,{Color=C.purple,Thickness=1.5},0.2)
		tw(searchGlowFrame,{BackgroundTransparency=0.85},0.2)
	end)
	searchBox.FocusLost:Connect(function()
		tw(searchBarStroke,{Color=C.border,Thickness=1.2},0.2)
		tw(searchGlowFrame,{BackgroundTransparency=0.9},0.2)
	end)


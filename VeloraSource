-- ─── key system ───────────────────────────────────────────────────────────────

local function showKeySystem(screen,keyCfg,onSuccess)
	local title       = keyCfg.Title       or "Velora UI"
	local subtitle    = keyCfg.Subtitle    or "Key System"
	local note        = keyCfg.Note        or "No method of obtaining the key is provided."
	local fileName    = (keyCfg.FileName   or "VeloraKey")..".txt"
	local saveKey     = keyCfg.SaveKey     ~= false
	local maxAttempts = keyCfg.MaxAttempts or 5
	local grabFromSite= keyCfg.GrabKeyFromSite == true
	local keyFile     = CONFIG_FOLDER.."/"..fileName
	local validKeys   = keyCfg.Key or {}
	local getKeyUrl   = keyCfg.GetKeyUrl

	-- resolve keys (fetch from URL if GrabKeyFromSite)
	local function resolveKeys()
		local resolved={}
		for _,k in ipairs(validKeys) do
			if grabFromSite and type(k)=="string" and k:sub(1,4)=="http" then
				local ok,r=pcall(function() return game:HttpGet(k) end)
				if ok and r and r~="" then
					table.insert(resolved,(r:match("^%s*(.-)%s*$")))
				end
			else
				table.insert(resolved,k)
			end
		end
		return resolved
	end

	-- check saved key first
	if saveKey then
		ensureFolder(CONFIG_FOLDER)
		local ok,saved=pcall(function() return readfile(keyFile) end)
		if ok and saved and saved~="" then
			local trimmed=saved:match("^%s*(.-)%s*$")
			local keys=resolveKeys()
			for _,k in ipairs(keys) do
				if trimmed==k then
					task.defer(onSuccess)
					return
				end
			end
		end
	end

	-- build key UI
	local overlay=newInst("Frame",{
		Size=UDim2.new(1,0,1,0),
		BackgroundColor3=Color3.fromRGB(6,4,14),
		BorderSizePixel=0,ZIndex=400,Parent=screen,
	})

	local card=newInst("Frame",{
		Size=UDim2.new(0,340,0,290),
		Position=UDim2.new(0.5,-170,0.5,-145),
		BackgroundColor3=Color3.fromRGB(12,10,24),
		BackgroundTransparency=1,
		BorderSizePixel=0,ZIndex=401,Parent=overlay,
	}); corner(16,card); stroke(C.border,1.5,card)

	-- logo circle
	local logoCircle=newInst("Frame",{
		Size=UDim2.new(0,64,0,64),Position=UDim2.new(0.5,-32,0,-32),
		BackgroundColor3=Color3.fromRGB(26,14,52),
		BorderSizePixel=0,ZIndex=403,Parent=card,
	}); corner(99,logoCircle); stroke(C.border,1.5,logoCircle)

	newInst("TextLabel",{
		Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
		Text=title:sub(1,3):upper(),TextColor3=C.purple,
		Font=Enum.Font.GothamBold,TextSize=20,ZIndex=404,Parent=logoCircle,
	})

	newInst("TextLabel",{
		Size=UDim2.new(1,-24,0,28),Position=UDim2.new(0,12,0,46),
		BackgroundTransparency=1,Text="Verify Your Key",
		TextColor3=C.textMain,Font=Enum.Font.GothamBold,TextSize=18,
		TextXAlignment=Enum.TextXAlignment.Center,ZIndex=402,Parent=card,
	})
	newInst("TextLabel",{
		Size=UDim2.new(1,-24,0,16),Position=UDim2.new(0,12,0,76),
		BackgroundTransparency=1,Text="Enter your key below to access "..title,
		TextColor3=C.textDim,Font=Enum.Font.Gotham,TextSize=11,
		TextXAlignment=Enum.TextXAlignment.Center,TextWrapped=true,
		ZIndex=402,Parent=card,
	})

	-- input row
	local inputRow=newInst("Frame",{
		Size=UDim2.new(1,-24,0,36),Position=UDim2.new(0,12,0,104),
		BackgroundColor3=C.inputBg,BorderSizePixel=0,ZIndex=402,Parent=card,
	}); corner(8,inputRow); stroke(C.border,1,inputRow)

	local keyTag=newInst("TextLabel",{
		Size=UDim2.new(0,38,1,0),BackgroundColor3=Color3.fromRGB(30,18,58),
		BorderSizePixel=0,Text="KEY",TextColor3=C.purple,
		Font=Enum.Font.GothamBold,TextSize=10,
		TextXAlignment=Enum.TextXAlignment.Center,ZIndex=403,Parent=inputRow,
	}); corner(6,keyTag)
	newInst("Frame",{
		Size=UDim2.new(0,8,1,0),Position=UDim2.new(1,-8,0,0),
		BackgroundColor3=Color3.fromRGB(30,18,58),BorderSizePixel=0,
		ZIndex=402,Parent=keyTag,
	})

	local keyBox=newInst("TextBox",{
		Size=UDim2.new(1,-48,1,0),Position=UDim2.new(0,46,0,0),
		BackgroundTransparency=1,Text="",
		PlaceholderText="Enter your verification key...",
		PlaceholderColor3=C.textDim,TextColor3=C.textMain,
		Font=Enum.Font.Gotham,TextSize=11,
		ClearTextOnFocus=false,ZIndex=404,Parent=inputRow,
	}); padding(0,0,4,8,keyBox)

	local statusLbl=newInst("TextLabel",{
		Size=UDim2.new(1,-24,0,14),Position=UDim2.new(0,12,0,146),
		BackgroundTransparency=1,Text=note,TextColor3=C.textDim,
		Font=Enum.Font.Gotham,TextSize=10,
		TextXAlignment=Enum.TextXAlignment.Center,TextWrapped=true,
		ZIndex=402,Parent=card,
	})

	local getKeyBtn=newInst("TextButton",{
		Size=UDim2.new(0.46,-6,0,38),Position=UDim2.new(0,12,0,176),
		BackgroundColor3=Color3.fromRGB(22,14,42),BorderSizePixel=0,
		Text="Get Key",TextColor3=C.textMain,
		Font=Enum.Font.GothamBold,TextSize=13,ZIndex=402,Parent=card,
	}); corner(8,getKeyBtn); stroke(C.border,1,getKeyBtn)

	local verifyBtn=newInst("TextButton",{
		Size=UDim2.new(0.54,-6,0,38),Position=UDim2.new(0.46,-6,0,176),
		BackgroundColor3=C.purple,BorderSizePixel=0,
		Text="Verify Key",TextColor3=Color3.fromRGB(255,255,255),
		Font=Enum.Font.GothamBold,TextSize=13,ZIndex=402,Parent=card,
	}); corner(8,verifyBtn)

	-- attempts counter label
	local attemptsLbl=newInst("TextLabel",{
		Size=UDim2.new(1,-24,0,14),Position=UDim2.new(0,12,0,220),
		BackgroundTransparency=1,Text="Attempts remaining: "..maxAttempts,
		TextColor3=C.textDim,Font=Enum.Font.Gotham,TextSize=10,
		TextXAlignment=Enum.TextXAlignment.Center,
		ZIndex=402,Parent=card,
	})

	-- entrance anim
	tween:Create(card,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
		BackgroundTransparency=0,
	}):Play()

	local attemptsLeft=maxAttempts
	local verifying=false

	local function setStatus(msg,col)
		statusLbl.Text=tostring(msg)
		statusLbl.TextColor3=col or C.textDim
	end

	-- shake animation (like Rayfield)
	local function shakeCard()
		local orig=card.Position
		local offsets={12,-12,8,-8,4,-4,2,-2,0}
		task.spawn(function()
			for _,ox in ipairs(offsets) do
				card.Position=UDim2.new(orig.X.Scale,orig.X.Offset+ox,orig.Y.Scale,orig.Y.Offset)
				task.wait(0.04)
			end
			card.Position=orig
		end)
	end

	local function dismiss()
		tween:Create(card,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
			BackgroundTransparency=1,
			Position=UDim2.new(0.5,-170,0.45,-145),
		}):Play()
		tween:Create(overlay,TweenInfo.new(0.3),{BackgroundTransparency=1}):Play()
		task.delay(0.35,function() overlay:Destroy() end)
	end

	getKeyBtn.MouseButton1Click:Connect(function()
		if getKeyUrl then
			pcall(function() setclipboard(getKeyUrl) end)
			setStatus("Key link copied to clipboard!",C.yellow)
		else
			setStatus("No key URL configured by the script author.",C.red)
		end
	end)

	verifyBtn.MouseButton1Click:Connect(function()
		if verifying then return end
		local entered=keyBox.Text:match("^%s*(.-)%s*$")
		if entered=="" then setStatus("Please enter a key first.",C.red); return end

		verifying=true
		setStatus("Verifying...",C.yellow)
		tween:Create(verifyBtn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(100,70,200)}):Play()

		task.spawn(function()
			local keys=resolveKeys()
			local valid=false
			for _,k in ipairs(keys) do
				if entered==k then valid=true;break end
			end

			if valid then
				setStatus("Key accepted! Loading...",C.green)
				tween:Create(verifyBtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(40,160,80)}):Play()
				if saveKey then
					ensureFolder(CONFIG_FOLDER)
					pcall(function() writefile(keyFile,entered) end)
				end
				task.delay(0.8,function()
					dismiss()
					task.delay(0.4,onSuccess)
				end)
			else
				attemptsLeft=attemptsLeft-1
				attemptsLbl.Text="Attempts remaining: "..attemptsLeft
				tween:Create(verifyBtn,TweenInfo.new(0.15),{BackgroundColor3=C.purple}):Play()

				if attemptsLeft<=0 then
					setStatus("No attempts remaining. Kicking...",C.red)
					task.delay(1.2,function()
						Players.LocalPlayer:Kick("[VeloraUI] Too many failed key attempts.")
					end)
				else
					setStatus("Invalid key. "..attemptsLeft.." attempt(s) remaining.",C.red)
					shakeCard()
					keyBox.Text=""
				end
				verifying=false
			end
		end)
	end)
end


-- ─── helpers ──────────────────────────────────────────────────────────────────

local function newInst(cls, props)
	local o = Instance.new(cls)
	for k, v in pairs(props) do o[k] = v end
	return o
end
local function corner(r, p)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,r); c.Parent = p
end
local function stroke(col, thick, parent)
	local s = Instance.new("UIStroke"); s.Color=col; s.Thickness=thick; s.Parent=parent; return s
end
local function padding(t,b,l,r,parent)
	local p = Instance.new("UIPadding")
	p.PaddingTop=UDim.new(0,t); p.PaddingBottom=UDim.new(0,b)
	p.PaddingLeft=UDim.new(0,l); p.PaddingRight=UDim.new(0,r)
	p.Parent=parent
end
local function listLayout(parent, gap, dir)
	local l = Instance.new("UIListLayout")
	l.SortOrder=Enum.SortOrder.LayoutOrder
	l.Padding=UDim.new(0,gap or 6)
	l.FillDirection=dir or Enum.FillDirection.Vertical
	l.Parent=parent; return l
end

-- ─── config save / load ───────────────────────────────────────────────────────

local CONFIG_FOLDER = "VeloraUI_Configs"
local CONFIG_FILE   = nil  -- set after window cfg is parsed

local function ensureFolder(folder)
	pcall(function()
		if not isfolder(folder) then makefolder(folder) end
	end)
end

local function saveConfig()
	if not CONFIG_FILE then return false end
	ensureFolder(CONFIG_FOLDER)
	local data = {}
	for flag, val in pairs(flags) do
		local t = type(val)
		if t=="boolean" or t=="number" or t=="string" then
			data[flag]=val
		elseif t=="table" then
			local safe=true
			for _,v in ipairs(val) do if type(v)~="string" then safe=false;break end end
			if safe then data[flag]=val end
		end
	end
	local ok=pcall(function() writefile(CONFIG_FILE, http:JSONEncode(data)) end)
	return ok
end

local function loadConfig()
	if not CONFIG_FILE then return nil end
	local ok,raw=pcall(function() return readfile(CONFIG_FILE) end)
	if not ok or not raw or raw=="" then return nil end
	local ok2,data=pcall(function() return http:JSONDecode(raw) end)
	if not ok2 or type(data)~="table" then return nil end
	return data
end

-- auto-save helper called by every element setter when autoSave is on
local function triggerAutoSave()
	if autoSave then
		pcall(saveConfig)
	end
end

-- ─── notification system ──────────────────────────────────────────────────────

local NOTIF_W   = 230
local NOTIF_H   = 54
local NOTIF_GAP = 8
local NOTIF_DUR = 3.2
local MAX_NOTIFS= 5

local notifActive = {}
local notifScreen = nil  -- assigned once ScreenGui exists

local function reflow()
	for i,entry in ipairs(notifActive) do
		local y=-(i*(NOTIF_H+NOTIF_GAP))
		tween:Create(entry.frame, TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
			Position=UDim2.new(1,-(NOTIF_W+10),1,y)
		}):Play()
	end
end

local function removeEntry(entry)
	for i,e in ipairs(notifActive) do
		if e==entry then table.remove(notifActive,i);break end
	end
	reflow()
end

local function notify(title,content,col)
	if not notifScreen then return end
	col=col or C.purple; title=tostring(title or "Notification"); content=tostring(content or "")

	if #notifActive>=MAX_NOTIFS then
		local oldest=notifActive[1]
		tween:Create(oldest.frame,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
			Position=UDim2.new(1,20,1,oldest.frame.Position.Y.Offset)
		}):Play()
		task.delay(0.22,function() if oldest.frame.Parent then oldest.frame:Destroy() end end)
		removeEntry(oldest)
	end

	local slot=#notifActive+1
	local startY=-(slot*(NOTIF_H+NOTIF_GAP))

	local notif=newInst("Frame",{
		Size=UDim2.new(0,NOTIF_W,0,NOTIF_H),
		Position=UDim2.new(1,20,1,startY),
		BackgroundColor3=Color3.fromRGB(10,8,22),
		BorderSizePixel=0,ZIndex=100,Parent=notifScreen,
	}); corner(12,notif); stroke(col,1.2,notif)

	local iconBox=newInst("Frame",{
		Size=UDim2.new(0,36,0,36),Position=UDim2.new(0,9,0.5,-18),
		BackgroundColor3=Color3.fromRGB(20,14,38),
		BorderSizePixel=0,ZIndex=101,Parent=notif,
	}); corner(8,iconBox); stroke(col,1,iconBox)

	local ic=newInst("Frame",{
		Size=UDim2.new(0,18,0,18),Position=UDim2.new(0.5,-9,0.5,-9),
		BackgroundColor3=col,BorderSizePixel=0,ZIndex=102,Parent=iconBox,
	}); corner(99,ic)
	newInst("Frame",{
		Size=UDim2.new(0,8,0,8),Position=UDim2.new(0.5,-4,0.5,-4),
		BackgroundColor3=Color3.fromRGB(10,8,22),BorderSizePixel=0,ZIndex=103,Parent=ic,
	})

	newInst("TextLabel",{
		Size=UDim2.new(1,-58,0,20),Position=UDim2.new(0,52,0,8),
		BackgroundTransparency=1,Text=title,TextColor3=col,
		TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold,
		TextSize=13,ZIndex=101,Parent=notif,
	})
	newInst("TextLabel",{
		Size=UDim2.new(1,-58,0,16),Position=UDim2.new(0,52,0,28),
		BackgroundTransparency=1,Text=content,
		TextColor3=Color3.fromRGB(130,110,170),
		TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham,
		TextSize=11,ZIndex=101,Parent=notif,
	})

	local entry={frame=notif}
	table.insert(notifActive,entry)

	tween:Create(notif,TweenInfo.new(0.32,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
		Position=UDim2.new(1,-(NOTIF_W+10),1,startY)
	}):Play()

	task.delay(NOTIF_DUR,function()
		if not notif.Parent then return end
		tween:Create(notif,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
			Position=UDim2.new(1,20,1,notif.Position.Y.Offset)
		}):Play()
		task.delay(0.28,function()
			if notif.Parent then notif:Destroy() end
			removeEntry(entry)
		end)
	end)
end


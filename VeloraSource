			if valid then
				setStatus("Key accepted! Loading...","success")
				tw(redeemBtn,{BackgroundColor3=Color3.fromRGB(28,110,55)},0.2)
				tw(inputStroke,{Color=C.green},0.2)
				redeemLbl.Text="✓ Accepted"
				if saveKey then
					ensureFolder(CONFIG_FOLDER)
					pcall(function() writefile(keyFile,entered) end)
				end
				task.delay(0.9,function() dismissCard(onSuccess) end)
			else
				attempts=attempts+1
				if attempts>=maxAtt then
					setStatus("No attempts remaining","error")
					task.delay(1.2,function() Players.LocalPlayer:Kick("[VeloraUI] Invalid key.") end)
				else
					setStatus("Invalid key. "..(maxAtt==math.huge and "" or (maxAtt-attempts).." attempts left"),"error")
					tw(inputStroke,{Color=C.red},0.15)
					shakeCard()
					task.delay(0.6,function() tw(inputStroke,{Color=C.border},0.3) end)
					redeemLbl.Text="Redeem Key";tw(redeemBtn,{BackgroundColor3=C.purple},0.2)
				end
				processing=false
			end
		end)
	end

	getKeyBtn.MouseButton1Click:Connect(function()
		if getKeyUrl then pcall(function() setclipboard(getKeyUrl) end);setStatus("Link copied to clipboard!","warning")
		else setStatus("No key URL set by the script author.","error") end
	end)
	redeemBtn.MouseButton1Click:Connect(function() tryValidate(keyBox.Text) end)
	keyBox.FocusLost:Connect(function(enter) if enter then tryValidate(keyBox.Text) end end)

	-- hover states
	getKeyBtn.MouseEnter:Connect(function() tw(getKeyBtn,{BackgroundColor3=Color3.fromRGB(26,18,46)},0.12) end)
	getKeyBtn.MouseLeave:Connect(function() tw(getKeyBtn,{BackgroundColor3=Color3.fromRGB(18,12,34)},0.12) end)
	redeemBtn.MouseEnter:Connect(function() tw(redeemBtn,{BackgroundColor3=Color3.fromRGB(140,80,220)},0.12) end)
	redeemBtn.MouseLeave:Connect(function() tw(redeemBtn,{BackgroundColor3=C.purple},0.12) end)
	buyBtn.MouseEnter:Connect(function() tw(buyBtn,{BackgroundColor3=Color3.fromRGB(40,26,64)},0.1) end)
	buyBtn.MouseLeave:Connect(function() tw(buyBtn,{BackgroundColor3=Color3.fromRGB(30,20,52)},0.1) end)
	buyBtn.MouseButton1Click:Connect(function()
		buyBtn.Text="Copied!";buyBtn.TextColor3=C.green
		task.delay(1.4,function() buyBtn.Text="BUY";buyBtn.TextColor3=C.yellow end)
	end)
end


local function notify(title, content, col, dur)
	if not notifScreen then return end
	local stack = ensureNotifStack()
	if not stack then return end
	col = col or C.accent
	title = tostring(title or "Notification")
	content = tostring(content or "")
	local now = os.clock()
	local key = title .. "\1" .. content

	local dup = notifDedupe[key]
	if dup and (now - dup.time) < 1.2 and dup.entry.frame.Parent then
		dup.count = dup.count + 1
		dup.time = now
		dup.entry.countLbl.Text = "x" .. dup.count
		dup.entry.countLbl.Visible = true
		return
	end

	if #notifActive >= MAX_NOTIFS then
		local oldest = table.remove(notifActive, 1)
		if oldest and oldest.frame.Parent then
			local f = oldest.frame
			tw(f, { BackgroundTransparency = 1 }, 0.2)
			task.delay(0.22, function() if f.Parent then f:Destroy() end end)
		end
	end

	local card = newInst("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 121,
		Parent = stack,
	})
	corner(14, card)
	vGrad(card, C.bgTop, C.bgBot, 120)
	local cardStroke = stroke(C.surfaceStroke, 1, card, 1)
	padding(11, 11, 14, 14, card)

	local bar = newInst("Frame", {
		Size = UDim2.new(0, 3, 0, 26),
		Position = UDim2.new(0, -6, 0.5, -13),
		BackgroundColor3 = col,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 122,
		Parent = card,
	})
	corner(99, bar)

	local wrap = newInst("Frame", {
		Size = UDim2.new(1, -18, 0, 0),
		Position = UDim2.new(0, 6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 122,
		Parent = card,
	})
	listLayout(wrap, 3)

	local titleLbl = newInst("TextLabel", {
		Size = UDim2.new(1, -24, 0, 16),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = C.textMain,
		TextTransparency = 1,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		ZIndex = 123,
		Parent = wrap,
	})

	local bodyLbl = nil
	if content ~= "" then
		bodyLbl = newInst("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = content,
			TextColor3 = C.textLight,
			TextTransparency = 1,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			ZIndex = 123,
			Parent = wrap,
		})
	end

	local countLbl = newInst("TextLabel", {
		Size = UDim2.new(0, 28, 0, 16),
		Position = UDim2.new(1, -24, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = col,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		ZIndex = 124,
		Visible = false,
		Parent = card,
	})

	local entry = { frame = card, countLbl = countLbl }
	table.insert(notifActive, entry)
	notifDedupe[key] = { entry = entry, count = 1, time = now }
	table.insert(notifHistory, 1, { title = title, content = content, at = os.time() })
	while #notifHistory > 20 do table.remove(notifHistory) end

	tw(card, { BackgroundTransparency = C.isLight and 0.04 or 0.08 }, 0.32)
	tw(cardStroke, { Transparency = C.isLight and 0.4 or 0.86 }, 0.32)
	tw(bar, { BackgroundTransparency = 0 }, 0.3)
	tw(titleLbl, { TextTransparency = 0 }, 0.28)
	if bodyLbl then tw(bodyLbl, { TextTransparency = 0.2 }, 0.32) end

	task.delay(dur or NOTIF_DUR, function()
		if not card.Parent then return end
		tw(card, { BackgroundTransparency = 1 }, 0.28)
		tw(cardStroke, { Transparency = 1 }, 0.25)
		tw(bar, { BackgroundTransparency = 1 }, 0.24)
		tw(titleLbl, { TextTransparency = 1 }, 0.22)
		if bodyLbl then tw(bodyLbl, { TextTransparency = 1 }, 0.22) end
		task.delay(0.3, function()
			if card.Parent then card:Destroy() end
			if notifDedupe[key] and notifDedupe[key].entry == entry then notifDedupe[key] = nil end
			for i, e in ipairs(notifActive) do
				if e == entry then table.remove(notifActive, i); break end
			end
		end)
	end)
end


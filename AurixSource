				applyViewportFit(false)
			end))
		end
	end
	bindCamera(workspace.CurrentCamera)
	track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		bindCamera(workspace.CurrentCamera)
		applyViewportFit(false)
	end))
	track(screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()

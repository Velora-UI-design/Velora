	local function clampCenterPos(x, y, curW, curH)
		local vp = getViewport(screen)
		local halfW = (curW * uiScale) / 2
		local halfH = (curH * uiScale) / 2
		local margin = 8
		local cx = math.clamp(x, halfW + margin, math.max(halfW + margin, vp.X - halfW - margin))
		local cy = math.clamp(y, halfH + margin, math.max(halfH + margin, vp.Y - halfH - margin))
		return cx, cy
	end

	local function syncDecor(instant)
		local curH = minimized and TOPBAR_H or winH
		local pos = win.Position
		local dragYOff = (curH * uiScale) / 2 + 14
		if instant then
			shadowFrame.Size = UDim2.fromOffset(winW + 26, curH + 26)
			shadowFrame.Position = pos
			shadowScale.Scale = uiScale
			dragBar.Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + dragYOff)
		else
			tw(shadowFrame, { Size = UDim2.fromOffset(winW + 26, curH + 26), Position = pos }, 0.32)
			tw(dragBar, { Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + dragYOff) }, 0.32)
		end
	end

	local function applyViewportFit(instant)
		if destroyed then return end
		local vp = getViewport(screen)
		local nw, nh, ns = computeWindowFit(vp, manualScale)
		winW, winH, uiScale = nw, nh, ns
		uiScaleObj.Scale = uiScale
		shadowScale.Scale = uiScale
		local curH = minimized and TOPBAR_H or winH

		if userDragged then
			local curCenter = win.AbsolutePosition + win.AbsoluteSize * 0.5
			local inset = GuiService:GetGuiInset()
			local cx, cy = clampCenterPos(curCenter.X + inset.X, curCenter.Y + inset.Y, winW, curH)
			win.Position = UDim2.fromOffset(cx, cy)
		else
			win.Position = UDim2.fromScale(0.5, 0.5)
		end

		if instant then
			win.Size = UDim2.fromOffset(winW, curH)
		else
			tw(win, { Size = UDim2.fromOffset(winW, curH) }, 0.3)
		end
		syncDecor(instant)
		updateNotifStackWidth()
	end


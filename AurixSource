					ClearTextOnFocus=false,ZIndex=6,Parent=menuFrame})
				corner(6,filterBox);padding(0,0,7,7,filterBox)
			end

			local optBtns={}
			local shownCount=0
			local unmatchedLbl=nil
			local function isSelected(opt)
				if multiSel then for _,v in ipairs(selected) do if v==opt then return true end end;return false
				else return selected==opt end
			end
			local function refreshColors()
				for opt,ob in pairs(optBtns) do tw(ob,{TextColor3=isSelected(opt) and C.accent or C.textLight},0.1) end
			end
			local function menuHeight()
				local h=shownCount*30 + (filterBox and 32 or 0)
				if shownCount==0 then h=h+30 end
				return h
			end

			local function buildOptions(needle)
				for _,c in pairs(menuFrame:GetChildren()) do
					if c:IsA("GuiObject") and c~=filterBox then c:Destroy() end
				end
				optBtns={}
				shownCount=0

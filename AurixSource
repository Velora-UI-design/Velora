		-- ==== SLIDER (Rayfield Gen2 pill handle + big touch hitbox + exact value box) ====
		function tabObj:CreateSlider(cfg2)
			cfg2 = cfg2 or {}
			local range = cfg2.Range or { 0, 100 }
			local inc = cfg2.Increment or 1
			if inc <= 0 then inc = 1 end
			local suffix = cfg2.Suffix or ""
			local cur = cfg2.CurrentValue ~= nil and cfg2.CurrentValue or range[1]
			local decimals = cfg2.Decimals
			if decimals == nil then
				decimals = 0
				while decimals < 4 do
					local sc = inc * (10 ^ decimals)
					if math.abs(sc - math.round(sc)) < 1e-6 then break end
					decimals = decimals + 1
				end
			end
			local sendNotif = cfg2.SendNotification == true
			if cfg2.Flag then flags[cfg2.Flag] = cur end

			local row = makeRow(66)
			table.insert(allElements, { frame = row, name = cfg2.Name or "Slider" })
			if cfg2.Tooltip then attachTooltip(row, cfg2.Tooltip) end

			local titleL = newInst("TextLabel", {
				Size = UDim2.new(1, -116, 0, 18),
				Position = UDim2.new(0, 14, 0, 10),
				BackgroundTransparency = 1,
				Text = cfg2.Name or "Slider",
				TextColor3 = C.textMain,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				ZIndex = 5,
				Parent = row,
			})

			local function numStr(v)
				if decimals > 0 then return string.format("%." .. decimals .. "f", v) end
				return tostring(math.floor(v + 0.5))
			end
			local function fmt(v)
				local t = numStr(v)
				return suffix ~= "" and (t .. " " .. suffix) or t
			end

			local valBox = newInst("TextBox", {
				Size = UDim2.fromOffset(88, 22),
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 8),
				BackgroundColor3 = C.inputBg,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				Text = fmt(cur),
				TextColor3 = C.accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				ClearTextOnFocus = false,
				ZIndex = 6,
				Parent = row,
			})
			corner(7, valBox)
			local vbStroke = stroke(C.rowStroke, 1, valBox, 0.5)
			padding(0, 0, 7, 7, valBox)

			-- generous 32px tall touch zone so mobile thumbs never miss
			local touchZone = newInst("TextButton", {
				Size = UDim2.new(1, -28, 0, 32),
				Position = UDim2.new(0, 14, 0, 32),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 7,
				Parent = row,
			})

			local trackBg = newInst("Frame", {
				Size = UDim2.new(1, 0, 0, 10),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				BackgroundColor3 = C.sliderTrack,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = touchZone,
			})
			corner(99, trackBg)

			local fill = newInst("Frame", {
				Size = UDim2.fromScale(0, 1),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = trackBg,
			})
			corner(99, fill)
			local fillGrad = vGrad(fill, C.accent, C.accent2, 0)

			local handle = newInst("Frame", {
				Size = UDim2.fromOffset(22, 16),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				BackgroundColor3 = C.sliderHandle,
				BorderSizePixel = 0,
				ZIndex = 8,
				Parent = fill,
			})
			corner(99, handle)
			local hStroke = stroke(C.accent, 1.5, handle, 0.6)

			onTheme(function()
				titleL.TextColor3 = C.textMain
				valBox.BackgroundColor3 = C.inputBg
				valBox.TextColor3 = C.accent
				vbStroke.Color = C.rowStroke
				trackBg.BackgroundColor3 = C.sliderTrack
				fillGrad.Color = ColorSequence.new(C.accent, C.accent2)
				handle.BackgroundColor3 = C.sliderHandle
				hStroke.Color = C.accent
			end)

			local editing = false
			local function setSlider(v, fire)
				local snapped = range[1] + math.round((v - range[1]) / inc) * inc
				v = math.clamp(snapped, range[1], range[2])
				cur = v
				if cfg2.Flag then flags[cfg2.Flag] = v end
				local span = math.max(range[2] - range[1], 1e-6)
				local pct = math.clamp((v - range[1]) / span, 0, 1)
				fill.Size = UDim2.new(pct, 0, 1, 0)
				if not editing then valBox.Text = fmt(v) end
				if fire then
					if cfg2.Callback then pcall(cfg2.Callback, v) end
					if sendNotif then notify(cfg2.Name or "Slider", fmt(v), C.accent, 1.8) end
					syncBadge()
					triggerAutoSave()
				end
			end
			setSlider(cur, false)
			if cfg2.Callback then pcall(cfg2.Callback, cur) end

			valBox.Focused:Connect(function()
				editing = true
				valBox.Text = numStr(cur)
				tw(vbStroke, { Color = C.accent, Transparency = 0 }, 0.16)
			end)
			valBox.FocusLost:Connect(function()
				editing = false
				tw(vbStroke, { Color = C.rowStroke, Transparency = 0.5 }, 0.16)
				local typed = tonumber((valBox.Text:gsub("[^%d%.%-]", "")))
				if typed then setSlider(typed, true) else valBox.Text = fmt(cur) end
			end)

			local sliding = false
			local function updateFromX(px)
				local rel = (px - trackBg.AbsolutePosition.X) / math.max(trackBg.AbsoluteSize.X, 1)
				setSlider(range[1] + (range[2] - range[1]) * math.clamp(rel, 0, 1), true)
			end

			touchZone.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					spring(handle, { Size = UDim2.fromOffset(28, 19) }, 0.16)
					tw(hStroke, { Transparency = 0.1 }, 0.15)
					updateFromX(i.Position.X)
				end
			end)
			track(UserInputService.InputChanged:Connect(function(i)
				if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
					updateFromX(i.Position.X)
				end
			end))
			track(UserInputService.InputEnded:Connect(function(i)
				if sliding and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
					sliding = false
					spring(handle, { Size = UDim2.fromOffset(22, 16) }, 0.18)
					tw(hStroke, { Transparency = 0.6 }, 0.18)
				end
			end))

			if cfg2.Flag then
				table.insert(saveItems, { flag = cfg2.Flag, setter = function(v) setSlider(tonumber(v) or cur, true) end })
			end
			local obj = {}
			function obj:Set(v) setSlider(v, true) end
			function obj:Get() return cur end
			if cfg2.Default ~= nil then addProbe(function() return cur ~= cfg2.Default end) end
			return obj
		end

		-- ==== DROPDOWN (capped scrollable list + smooth expand + filter) ====
		function tabObj:CreateDropdown(cfg2)
			cfg2 = cfg2 or {}
			local options = cfg2.Options or {}
			local multiSel = cfg2.MultipleOptions == true
			local selected
			if multiSel then
				selected = (type(cfg2.CurrentOption) == "table") and cfg2.CurrentOption or {}
			else
				local co = cfg2.CurrentOption
				if type(co) == "table" then co = co[1] end
				selected = co or options[1] or ""
			end
			local sendNotif = cfg2.SendNotification ~= false
			if cfg2.Flag then flags[cfg2.Flag] = selected end
			local open = false

			local row = makeRow(nil, true)
			padding(10, 10, 14, 14, row)
			listLayout(row, 6)
			table.insert(allElements, { frame = row, name = cfg2.Name or "Dropdown" })
			if cfg2.Tooltip then attachTooltip(row, cfg2.Tooltip) end

			local header = newInst("TextButton", {
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 5,
				Parent = row,
			})
			local nameLbl = newInst("TextLabel", {
				Size = UDim2.new(0.48, 0, 1, 0),

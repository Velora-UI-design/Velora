	-- search logic
	local allElements = {}
	local function runSearch(query)
		query = query:lower():gsub("^%s*(.-)%s*$", "%1")
		local hits = 0
		for _, entry in ipairs(allElements) do
			if entry.frame and entry.frame.Parent and not entry.isSection then
				local vis = (query == "") or (entry.name:lower():find(query, 1, true) ~= nil)
				entry.frame.Visible = vis
				if vis then hits = hits + 1 end
			end
		end
		for _, entry in ipairs(allElements) do
			if entry.isSection and entry.frame and entry.frame.Parent then
				local any = false
				for _, r in ipairs(entry.rows) do
					if r.Visible then any = true; break end
				end
				entry.frame.Visible = (query == "") or any
			end
		end
		local miss = (query ~= "" and hits == 0)
		emptyState.Visible = miss
		emptySub.Text = miss and ('Nothing matches "' .. query .. '"') or ""
	end

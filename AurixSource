-- ==== RESPONSIVE VIEWPORT SIZING (Rayfield Gen2 style) ====
local MIN_PLAUSIBLE_VP = 200
local IDEAL_W, IDEAL_H = 500, 500
local MIN_W, MIN_H = 320, 250

local function getViewport(screen)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < MIN_PLAUSIBLE_VP or vp.Y < MIN_PLAUSIBLE_VP then
		if screen and screen.AbsoluteSize.X >= MIN_PLAUSIBLE_VP and screen.AbsoluteSize.Y >= MIN_PLAUSIBLE_VP then
			vp = screen.AbsoluteSize
		else
			vp = Vector2.new(1280, 720)
		end
	end
	return vp
end

local function computeWindowFit(vp, manualScale)
	local scale
	if manualScale then
		scale = math.clamp(manualScale, 0.65, 1.4)
	else
		if vp.Y <= 440 or vp.X <= 480 then
			scale = math.clamp(math.min(vp.Y / 450, vp.X / 500), 0.76, 0.88)
		elseif vp.Y < 700 or vp.X < 960 then
			scale = math.clamp(math.min(vp.Y / 720, vp.X / 960), 0.86, 0.96)
		else
			scale = 1
		end
	end

	local marginX = math.max(20, math.floor(vp.X * 0.06))
	local availX = math.min(vp.X * 0.90, vp.X - marginX)
	local topbarClear = (vp.Y < 460) and 30 or 38
	local availY = math.min(vp.Y - 24, vp.Y - topbarClear * 2)

	local logAvailX = math.max(260, availX / scale)
	local logAvailY = math.max(210, availY / scale)

	local h = math.floor(math.min(math.clamp(logAvailY, MIN_H, IDEAL_H), logAvailY))
	local lost = math.clamp((IDEAL_H - h) / math.max(IDEAL_H - MIN_H, 1), 0, 1)
	local wantW = IDEAL_W + 90 * lost
	local w = math.floor(math.min(wantW, logAvailX, h * 2.25))
	w = math.max(w, math.min(MIN_W, math.floor(logAvailX)))
	h = math.max(h, math.min(MIN_H, math.floor(logAvailY)))

	return w, h, scale
end

-- ==== CONFIG SAVE / LOAD ====
local function ensureFolder(folder)
	pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
			if not isfolder(folder) then makefolder(folder) end
		end
	end)
end

local function configPath(name)
	return CONFIG_FOLDER .. "/" .. tostring(name) .. ".json"
end

local function configList()
	local out = {}
	if typeof(listfiles) ~= "function" then return out end
	pcall(function()
		ensureFolder(CONFIG_FOLDER)
		for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
			local name = f:match("([^/\\]+)%.json$")
			if name and name ~= "session" then table.insert(out, name) end
		end
	end)
	table.sort(out)
	return out
end

local function snapshotFlags()
	local snap = {}
	for k, v in pairs(flags) do
		if type(v) == "table" then snap[k] = table.concat(v, ",") else snap[k] = v end
	end
	return snap
end

local function isDirty()
	if not savedSnapshot then return false end
	local now = snapshotFlags()
	for k, v in pairs(now) do if savedSnapshot[k] ~= v then return true end end
	for k, v in pairs(savedSnapshot) do if now[k] ~= v then return true end end
	return false
end

local function serialisable(v)
	local t = type(v)
	if t == "boolean" or t == "number" or t == "string" then return true end
	if t == "table" then
		for _, x in ipairs(v) do if type(x) ~= "string" then return false end end
		return true
	end
	return false
end

local function collectFlags()
	local data = {}
	for flag, val in pairs(flags) do
		if serialisable(val) then data[flag] = val end
	end
	return data
end

local function saveConfig(path)
	if not path then return false end
	ensureFolder(CONFIG_FOLDER)
	local ok = pcall(function() writefile(path, HttpService:JSONEncode(collectFlags())) end)
	if ok then savedSnapshot = snapshotFlags() end
	return ok
end

local function readConfig(path)
	if not path then return nil end
	local ok, raw = pcall(function() return readfile(path) end)
	if not ok or not raw or raw == "" then return nil end
	local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return nil end
	return data
end

local function applyConfig(data)
	if type(data) ~= "table" then return false end
	for _, item in ipairs(saveItems) do
		local v = data[item.flag]
		if v ~= nil then pcall(item.setter, v) end
	end
	savedSnapshot = snapshotFlags()
	return true
end

local function deleteConfig(name)
	return (pcall(function() delfile(configPath(name)) end))
end

local function triggerAutoSave()
	if autoSave and CONFIG_FILE then pcall(saveConfig, CONFIG_FILE) end
end

-- ==== TOOLTIPS ====
local notifScreen = nil
local TT_DELAY = 0.42
local ttRoot, ttLabel, ttStroke, ttToken = nil, nil, nil, 0

local function ensureTooltip()
	if ttRoot and ttRoot.Parent then return true end
	if not notifScreen then return false end
	ttRoot = newInst("Frame", {
		Size = UDim2.new(0, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = C.bgDeep,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 900,
		Visible = false,
		Parent = notifScreen,
	})
	corner(10, ttRoot)
	ttStroke = stroke(C.rowStroke, 1, ttRoot, 1)
	padding(8, 8, 11, 11, ttRoot)
	ttLabel = newInst("TextLabel", {
		Size = UDim2.new(0, 210, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = C.textLight,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextTransparency = 1,
		ZIndex = 901,
		Parent = ttRoot,
	})
	return true
end

local function hideTooltip()
	ttToken = ttToken + 1
	if not (ttRoot and ttRoot.Parent) then return end
	local token = ttToken
	tw(ttRoot, { BackgroundTransparency = 1 }, 0.14)
	if ttLabel then tw(ttLabel, { TextTransparency = 1 }, 0.12) end
	if ttStroke then tw(ttStroke, { Transparency = 1 }, 0.14) end
	task.delay(0.16, function()
		if ttRoot and ttRoot.Parent and token == ttToken then ttRoot.Visible = false end
	end)
end

local function attachTooltip(gui, text)
	if not text or text == "" then return end
	gui.MouseEnter:Connect(function()
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then return end
		if not ensureTooltip() then return end
		ttToken = ttToken + 1
		local token = ttToken
		task.delay(TT_DELAY, function()
			if token ~= ttToken or not gui.Parent or not gui.Visible then return end
			local vp = getViewport(notifScreen)
			ttRoot.BackgroundColor3 = C.bgDeep
			ttLabel.TextColor3 = C.textLight
			ttStroke.Color = C.rowStroke
			ttLabel.Text = text
			ttRoot.Visible = true
			ttRoot.BackgroundTransparency = 1
			ttLabel.TextTransparency = 1
			ttStroke.Transparency = 1
			task.defer(function()
				if token ~= ttToken or not ttRoot.Parent then return end
				local w = ttRoot.AbsoluteSize.X
				local h = ttRoot.AbsoluteSize.Y
				local pos = gui.AbsolutePosition
				local gs = gui.AbsoluteSize
				local x = math.clamp(pos.X, 8, math.max(8, vp.X - w - 8))
				local y = pos.Y + gs.Y + 6
				if y + h > vp.Y - 8 then y = pos.Y - h - 6 end
				ttRoot.Position = UDim2.fromOffset(x, math.max(8, y))
				tw(ttRoot, { BackgroundTransparency = 0.04 }, 0.18)
				tw(ttLabel, { TextTransparency = 0 }, 0.16)
				tw(ttStroke, { Transparency = 0.2 }, 0.18)
			end)
		end)
	end)
	gui.MouseLeave:Connect(hideTooltip)
end


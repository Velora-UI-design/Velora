local TT_DELAY=0.4
local ttRoot,ttLabel,ttToken=nil,nil,0

local function ensureTooltip()
	if ttRoot and ttRoot.Parent then return true end
	if not notifScreen then return false end
	ttRoot=newInst("Frame",{Size=UDim2.new(0,0,0,0),AutomaticSize=Enum.AutomaticSize.XY,
		BackgroundColor3=Color3.fromRGB(10,22,28),BackgroundTransparency=1,
		BorderSizePixel=0,ZIndex=900,Visible=false,Parent=notifScreen})
	corner(8,ttRoot)
	local s=stroke(Color3.fromRGB(70,173,235),1,ttRoot);s.Transparency=1
	padding(7,7,10,10,ttRoot)
	ttLabel=newInst("TextLabel",{Size=UDim2.new(0,206,0,0),AutomaticSize=Enum.AutomaticSize.Y,
		BackgroundTransparency=1,Text="",TextColor3=Color3.fromRGB(150,192,220),
		TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,
		Font=Enum.Font.Gotham,TextSize=11,TextTransparency=1,ZIndex=901,Parent=ttRoot})
	return true
end

local function hideTooltip()
	ttToken=ttToken+1
	if not (ttRoot and ttRoot.Parent) then return end
	local token=ttToken
	tw(ttRoot,{BackgroundTransparency=1},0.12)
	if ttLabel then tw(ttLabel,{TextTransparency=1},0.1) end
	local s=ttRoot:FindFirstChildOfClass("UIStroke")
	if s then tw(s,{Transparency=1},0.12) end
	task.delay(0.15,function()
		if ttRoot and ttRoot.Parent and token==ttToken then ttRoot.Visible=false end
	end)
end

local function attachTooltip(gui,text)
	if not text or text=="" then return end
	gui.MouseEnter:Connect(function()
		if not ensureTooltip() then return end
		ttToken=ttToken+1
		local token=ttToken
		task.delay(TT_DELAY,function()
			if token~=ttToken or not gui.Parent or not gui.Visible then return end
			local vp=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
			ttLabel.Text=text
			ttRoot.Visible=true
			ttRoot.BackgroundTransparency=1
			ttLabel.TextTransparency=1
			local s=ttRoot:FindFirstChildOfClass("UIStroke")
			if s then s.Transparency=1 end
			-- measured after the text lands so the clamp uses the real size
			task.defer(function()
				local w=ttRoot.AbsoluteSize.X
				local h=ttRoot.AbsoluteSize.Y
				local pos=gui.AbsolutePosition
				local gs=gui.AbsoluteSize
				local x=math.clamp(pos.X,8,math.max(8,vp.X-w-8))
				local y=pos.Y+gs.Y+6
				if y+h>vp.Y-8 then y=pos.Y-h-6 end
				ttRoot.Position=UDim2.fromOffset(x,math.max(8,y))
				tw(ttRoot,{BackgroundTransparency=0.04},0.16)
				tw(ttLabel,{TextTransparency=0},0.14)
				if s then tw(s,{Transparency=0.25},0.16) end
			end)
		end)
	end)
	gui.MouseLeave:Connect(hideTooltip)
end

-- ── Config state ──────────────────────────────────────────────────────────────
local savedSnapshot=nil

local function snapshotFlags()
	local snap={}
	for k,v in pairs(flags) do
		if type(v)=="table" then snap[k]=table.concat(v,",") else snap[k]=v end
	end
	return snap
end

-- true when a live flag differs from the last saved or loaded file
local function isDirty()
	if not savedSnapshot then return false end
	local now=snapshotFlags()
	for k,v in pairs(now) do if savedSnapshot[k]~=v then return true end end
	for k,v in pairs(savedSnapshot) do if now[k]~=v then return true end end
	return false
end

local function configPath(name) return CONFIG_FOLDER.."/"..tostring(name)..".json" end

local function configList()
	local out={}
	if typeof(listfiles)~="function" then return out end
	pcall(function()
		ensureFolder(CONFIG_FOLDER)
		for _,f in ipairs(listfiles(CONFIG_FOLDER)) do
			local name=f:match("([^/\\]+)%.json$")
			if name then table.insert(out,name) end
		end
	end)
	table.sort(out)
	return out
end

-- ── Config save / load ────────────────────────────────────────────────────────
local CONFIG_FOLDER = "AurixUI_Configs"
local CONFIG_FILE   = nil

local function ensureFolder(folder)
	pcall(function() if not isfolder(folder) then makefolder(folder) end end)
end
local function serialisable(v)
	local t=type(v)
	if t=="boolean" or t=="number" or t=="string" then return true end
	if t=="table" then
		for _,x in ipairs(v) do if type(x)~="string" then return false end end
		return true
	end
	return false
end

local function collectFlags()
	local data={}
	for flag,val in pairs(flags) do
		if serialisable(val) then data[flag]=val end
	end
	return data
end

local function saveConfig(path)
	if not path then return false end
	ensureFolder(CONFIG_FOLDER)
	local ok=pcall(function() writefile(path,http:JSONEncode(collectFlags())) end)
	if ok then savedSnapshot=snapshotFlags() end
	return ok
end

local function readConfig(path)
	if not path then return nil end
	local ok,raw=pcall(function() return readfile(path) end)
	if not ok or not raw or raw=="" then return nil end
	local ok2,data=pcall(function() return http:JSONDecode(raw) end)
	if not ok2 or type(data)~="table" then return nil end
	return data
end

local function applyConfig(data)
	if type(data)~="table" then return false end
	for _,item in ipairs(saveItems) do
		local v=data[item.flag]
		if v~=nil then pcall(item.setter,v) end
	end
	savedSnapshot=snapshotFlags()
	return true
end

local function loadConfig(path) return applyConfig(readConfig(path)) end

local function deleteConfig(name)
	return (pcall(function() delfile(configPath(name)) end))
end

local function triggerAutoSave()
	if autoSave then pcall(saveConfig) end
end

-- ── Notifications ─────────────────────────────────────────────────────────────
local NOTIF_W=230; local NOTIF_H=54; local NOTIF_GAP=8
local NOTIF_DUR=3.2; local MAX_NOTIFS=4
local notifActive={}; notifScreen=nil

local function reflow()
	for i,entry in ipairs(notifActive) do
		tw(entry.frame,{Position=UDim2.new(1,-(NOTIF_W+10),1,-(i*(NOTIF_H+NOTIF_GAP)))},0.2,Enum.EasingStyle.Quad)
	end
end
local function removeEntry(entry)
	for i,e in ipairs(notifActive) do if e==entry then table.remove(notifActive,i);break end end
	reflow()
end
local notifHistory={}
local notifDedupe={}

local function notify(title,content,col)
	if not notifScreen then return end
	col=col or C.accent;title=tostring(title or "Notification");content=tostring(content or "")
	local now=os.clock()
	local key=title.."\1"..content

	-- a repeat inside 1.2s bumps a counter instead of stacking a twin
	local dup=notifDedupe[key]
	if dup and (now-dup.time)<1.2 and dup.entry.frame.Parent then
		dup.count=dup.count+1;dup.time=now
		dup.entry.countLbl.Text="x"..dup.count
		dup.entry.countLbl.Visible=true
		return
	end

	if #notifActive>=MAX_NOTIFS then
		local oldest=notifActive[1]
		tw(oldest.frame,{Position=UDim2.new(1,20,1,oldest.frame.Position.Y.Offset)},0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
		task.delay(0.22,function() if oldest.frame.Parent then oldest.frame:Destroy() end end)
		removeEntry(oldest)
	end
	local slot=#notifActive+1
	local startY=-(slot*(NOTIF_H+NOTIF_GAP))
	local notif=newInst("Frame",{
		Size=UDim2.new(0,NOTIF_W,0,NOTIF_H),Position=UDim2.new(1,20,1,startY),
		BackgroundColor3=Color3.fromRGB(8,17,22),BorderSizePixel=0,ZIndex=100,Parent=notifScreen})
	corner(12,notif);stroke(col,1.2,notif)
	local iconBox=newInst("Frame",{Size=UDim2.new(0,36,0,36),Position=UDim2.new(0,9,0.5,-18),
		BackgroundColor3=Color3.fromRGB(14,29,38),BorderSizePixel=0,ZIndex=101,Parent=notif})
	corner(8,iconBox);stroke(col,1,iconBox)
	local ic=newInst("Frame",{Size=UDim2.new(0,18,0,18),Position=UDim2.new(0.5,-9,0.5,-9),
		BackgroundColor3=col,BorderSizePixel=0,ZIndex=102,Parent=iconBox});corner(99,ic)
	newInst("Frame",{Size=UDim2.new(0,8,0,8),Position=UDim2.new(0.5,-4,0.5,-4),
		BackgroundColor3=Color3.fromRGB(8,17,22),BorderSizePixel=0,ZIndex=103,Parent=ic})
	newInst("TextLabel",{Size=UDim2.new(1,-84,0,20),Position=UDim2.new(0,52,0,8),
		BackgroundTransparency=1,Text=title,TextColor3=col,TextTruncate=Enum.TextTruncate.AtEnd,
		TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold,TextSize=13,ZIndex=101,Parent=notif})
	newInst("TextLabel",{Size=UDim2.new(1,-84,0,16),Position=UDim2.new(0,52,0,28),
		BackgroundTransparency=1,Text=content,TextColor3=Color3.fromRGB(110,147,170),
		TextTruncate=Enum.TextTruncate.AtEnd,
		TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham,TextSize=11,ZIndex=101,Parent=notif})
	local countLbl=newInst("TextLabel",{Size=UDim2.new(0,26,0,14),Position=UDim2.new(1,-30,0,7),
		BackgroundTransparency=1,Text="",TextColor3=col,TextXAlignment=Enum.TextXAlignment.Right,
		Font=Enum.Font.GothamBold,TextSize=10,ZIndex=102,Visible=false,Parent=notif})
	local entry={frame=notif,countLbl=countLbl}
	table.insert(notifActive,entry)
	notifDedupe[key]={entry=entry,count=1,time=now}
	table.insert(notifHistory,1,{title=title,content=content,at=os.time()})
	while #notifHistory>20 do table.remove(notifHistory) end
	spring(notif,{Position=UDim2.new(1,-(NOTIF_W+10),1,startY)},0.4)
	task.delay(NOTIF_DUR,function()
		if not notif.Parent then return end
		tw(notif,{Position=UDim2.new(1,20,1,notif.Position.Y.Offset)},0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
		task.delay(0.28,function()
			if notif.Parent then notif:Destroy() end
			if notifDedupe[key] and notifDedupe[key].entry==entry then notifDedupe[key]=nil end
			removeEntry(entry)
		end)
	end)
end


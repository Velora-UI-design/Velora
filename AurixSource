local currentTheme="ice"

local function colKey(c)
	return string.format("%d,%d,%d",
		math.floor(c.R*255+0.5),math.floor(c.G*255+0.5),math.floor(c.B*255+0.5))
end

-- Copies palette values into C. Always run before the UI is built so new
-- instances pick the theme up at creation.
local function applyTheme(name)
	local pal=THEMES[name]
	if not pal then return false end
	for k,v in pairs(pal) do C[k]=v end
	currentTheme=name
	return true
end

-- Repaints live instances. Colour3 cannot be used as a table key (two equal
-- colours are different userdata), so everything is matched through a "r,g,b"
-- string built from the old palette, then written back as the new value.
local function retint(root,oldPal)
	local map={}
	for k,nv in pairs(C) do
		local ov=oldPal[k]
		if typeof(ov)=="Color3" and typeof(nv)=="Color3" then map[colKey(ov)]=nv end
	end
	local function remap(c)
		if typeof(c)~="Color3" then return nil end
		return map[colKey(c)]
	end

	local list={root}
	for _,d in ipairs(root:GetDescendants()) do table.insert(list,d) end
	for _,o in ipairs(list) do
		if o:IsA("GuiObject") then
			local nb=remap(o.BackgroundColor3);if nb then o.BackgroundColor3=nb end
			if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
				local nt=remap(o.TextColor3);if nt then o.TextColor3=nt end
			elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
				local ni=remap(o.ImageColor3);if ni then o.ImageColor3=ni end
			end
		elseif o:IsA("UIStroke") then
			local ns=remap(o.Color);if ns then o.Color=ns end
		elseif o:IsA("UIGradient") then
			local keys=o.Color.Keypoints
			local hit=false
			for _,kp in ipairs(keys) do if remap(kp.Value) then hit=true;break end end
			if hit then
				local built={}
				for _,kp in ipairs(keys) do
					table.insert(built,ColorSequenceKeypoint.new(kp.Time,remap(kp.Value) or kp.Value))
				end
				o.Color=ColorSequence.new(built)
			end
		end
	end
end


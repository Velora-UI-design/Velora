				TextColor3 = C.textMain,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				ZIndex = 5,
				Parent = header,
			})
			local function displayText()
				if multiSel then
					if #selected == 0 then return "None" end
					return table.concat(selected, ", ")
				end
				return tostring(selected ~= "" and selected or "None")
			end
			local selPill = newInst("Frame", {
				Size = UDim2.new(0.5, -6, 0, 26),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				BackgroundColor3 = C.inputBg,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = header,
			})
			corner(8, selPill)
			local selStroke = stroke(C.rowStroke, 1, selPill, 0.4)
			local selLbl = newInst("TextLabel", {
				Size = UDim2.new(1, -24, 1, 0),
				Position = UDim2.new(0, 9, 0, 0),
				BackgroundTransparency = 1,
				Text = displayText(),
				TextColor3 = C.textLight,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamMedium,
				TextSize = 11,
				ZIndex = 6,
				Parent = selPill,
			})
			local chev = newInst("TextLabel", {
				Size = UDim2.fromOffset(18, 18),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -5, 0.5, 0),
				BackgroundTransparency = 1,
				Text = "v",
				TextColor3 = C.textDim,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				ZIndex = 6,
				Parent = selPill,
			})

			local menuWrap = newInst("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				BackgroundColor3 = C.bgDeep,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Visible = false,
				ZIndex = 5,
				Parent = row,
			})
			corner(10, menuWrap)
			local menuStroke = stroke(C.rowStroke, 1, menuWrap, 0.45)

			local filterBox = nil
			local filterH = 0
			local function ensureFilter()
				if #options > (cfg2.SearchThreshold or 6) and not filterBox then
					filterH = 34
					filterBox = newInst("TextBox", {
						Size = UDim2.new(1, -12, 0, 26),
						Position = UDim2.new(0, 6, 0, 6),
						BackgroundColor3 = C.inputBg,
						BorderSizePixel = 0,
						Text = "",
						PlaceholderText = "Filter...",
						PlaceholderColor3 = C.textDim,
						TextColor3 = C.textMain,
						Font = Enum.Font.Gotham,
						TextSize = 11,
						TextXAlignment = Enum.TextXAlignment.Left,
						ClearTextOnFocus = false,
						ZIndex = 7,
						Parent = menuWrap,
					})
					corner(7, filterBox)
					padding(0, 0, 8, 8, filterBox)
				end
			end
			ensureFilter()

			local optScroll = newInst("ScrollingFrame", {
				Size = UDim2.new(1, 0, 1, -filterH),
				Position = UDim2.new(0, 0, 0, filterH),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 2,
				ScrollBarImageColor3 = C.accentDim,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				ZIndex = 6,
				Parent = menuWrap,
			})
			padding(4, 4, 5, 5, optScroll)
			local optLayout = listLayout(optScroll, 3)

			local optBtns = {}
			local shownCount = 0
			local function isSelected(opt)
				if multiSel then
					for _, v in ipairs(selected) do if v == opt then return true end end
					return false
				end
				return selected == opt
			end

			local function paintOptBtn(ob, on)
				ob.BackgroundColor3 = on and C.accentFade or C.bgRowHover
				ob.BackgroundTransparency = on and 0.15 or 1
				ob.TextColor3 = on and C.accent or C.textLight
			end

			local function refreshColors()
				for opt, ob in pairs(optBtns) do paintOptBtn(ob, isSelected(opt)) end
			end

			local function menuHeight()
				local rowsH = math.max(1, shownCount) * 31 + 8
				return math.min(182, rowsH + filterH)
			end

			local function buildOptions(needle)
				for _, c in ipairs(optScroll:GetChildren()) do
					if c:IsA("GuiObject") then c:Destroy() end
				end
				optBtns = {}
				shownCount = 0
				needle = tostring(needle or ""):lower()
				for _, opt in ipairs(options) do
					if needle == "" or tostring(opt):lower():find(needle, 1, true) then
						shownCount = shownCount + 1
						local ob = newInst("TextButton", {
							Size = UDim2.new(1, 0, 0, 28),
							BackgroundColor3 = C.accentFade,
							BackgroundTransparency = 1,
							BorderSizePixel = 0,
							AutoButtonColor = false,
							Text = tostring(opt),
							TextColor3 = C.textLight,
							TextXAlignment = Enum.TextXAlignment.Left,
							TextTruncate = Enum.TextTruncate.AtEnd,
							Font = Enum.Font.GothamMedium,
							TextSize = 11,
							ZIndex = 7,
							Parent = optScroll,
						})
						corner(7, ob)
						padding(0, 0, 9, 9, ob)
						paintOptBtn(ob, isSelected(opt))
						optBtns[opt] = ob

						ob.MouseEnter:Connect(function()
							if not isSelected(opt) then
								tw(ob, { BackgroundTransparency = 0.55, TextColor3 = C.textMain }, 0.12)
							end
						end)
						ob.MouseLeave:Connect(function()
							if not isSelected(opt) then
								tw(ob, { BackgroundTransparency = 1, TextColor3 = C.textLight }, 0.14)
							end
						end)
						ob.MouseButton1Click:Connect(function()
							if multiSel then
								local found = false
								for i, v in ipairs(selected) do
									if v == opt then table.remove(selected, i); found = true; break end
								end
								if not found then table.insert(selected, opt) end
								refreshColors()
								selLbl.Text = displayText()
								if cfg2.Flag then flags[cfg2.Flag] = selected end
								if cfg2.Callback then pcall(cfg2.Callback, selected) end
								if sendNotif then notify(cfg2.Name or "Dropdown", "Selected: " .. displayText(), C.accent, 2) end
							else
								selected = opt
								selLbl.Text = displayText()
								refreshColors()
								open = false
								tw(chev, { Rotation = 0 }, 0.22)
								tw(menuWrap, { Size = UDim2.new(1, 0, 0, 0) }, 0.2)
								task.delay(0.22, function() if not open then menuWrap.Visible = false end end)
								if cfg2.Flag then flags[cfg2.Flag] = opt end
								if cfg2.Callback then pcall(cfg2.Callback, opt) end
								if sendNotif then notify(cfg2.Name or "Dropdown", "Selected: " .. tostring(opt), C.accent, 2) end
							end
							triggerAutoSave()
						end)
					end
				end
				if shownCount == 0 then
					newInst("TextLabel", {

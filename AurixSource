	-- shake helper
	local function shakeCard()
		local orig=card.Position;local ox=orig.X.Offset
		for _,off in ipairs({7,-7,5,-5,2,-2,0}) do
			card.Position=UDim2.new(orig.X.Scale,ox+off,orig.Y.Scale,orig.Y.Offset)
			task.wait(0.03)
		end
		card.Position=orig
	end

	-- resolve keys (fetch live if GrabKeyFromSite)
	local function resolveKeys()
		local out={}
		for _,k in ipairs(validKeys) do
			if type(k)=="string" and k:sub(1,4)=="http" and keyCfg.GrabKeyFromSite then
				local ok,r=pcall(function() return game:HttpGet(k) end)
				if ok then table.insert(out,r:match("^%s*(.-)%s*$")) end
			else table.insert(out,k) end
		end
		return out
	end


							notify("Config",name.." loaded",C.green)
						else
							notify("Config","Could not read "..name,C.red)
						end
					end)
					-- two taps so a slot is never deleted by a stray click
					local armed=false
					db.MouseButton1Click:Connect(function()
						if not armed then
							armed=true;db.Text="Sure?";db.TextColor3=C.yellow
							task.delay(2,function()
								if armed and db.Parent then
									armed=false;db.Text="Del";db.TextColor3=C.red
								end
							end)
							return
						end
						armed=false
						db.Text="Del";db.TextColor3=C.red
						deleteConfig(name)
						notify("Config",name.." deleted",C.red)
						refresh()
					end)
					db.MouseEnter:Connect(function() tw(db,{BackgroundColor3=Color3.fromRGB(44,16,24)},0.12) end)
					db.MouseLeave:Connect(function() tw(db,{BackgroundColor3=Color3.fromRGB(26,12,20)},0.12) end)
					lb.MouseEnter:Connect(function() tw(lb,{BackgroundColor3=Color3.fromRGB(20,43,58)},0.12) end)
					lb.MouseLeave:Connect(function() tw(lb,{BackgroundColor3=Color3.fromRGB(14,33,46)},0.12) end)
				end
			end

			saveBtn.MouseButton1Click:Connect(function()
				local name=nameBox.Text:gsub("[^%w_%- ]",""):gsub("^%s+",""):gsub("%s+$","")
				if name=="" then name=tostring(game.PlaceId) end
				if saveConfig(configPath(name)) then
					nameBox.Text=""
					notify("Config",name.." saved",C.green)
					refresh()
				else
					notify("Config","Save failed",C.red)
				end
			end)
			saveBtn.MouseEnter:Connect(function() tw(saveBtn,{BackgroundColor3=Color3.fromRGB(20,43,58)},0.12) end)
			saveBtn.MouseLeave:Connect(function() tw(saveBtn,{BackgroundColor3=Color3.fromRGB(14,33,46)},0.12) end)

			refresh()
			task.spawn(function()
				while row.Parent do
					dirtyDot.Visible=isDirty()
					task.wait(0.5)
				end
			end)
			local obj={}
			function obj:Refresh() refresh() end
			return obj
		end

		-- Input
		function tabObj:CreateInput(cfg2)
			cfg2=cfg2 or {}
			local val=cfg2.CurrentValue or ""
			if cfg2.Flag then flags[cfg2.Flag]=val end
			local row=makeRow(nil,true);padding(10,10,10,10,row);listLayout(row,6)
			table.insert(allElements,{frame=row,name=cfg2.Name or "Input"})
			if cfg2.Tooltip then attachTooltip(row,cfg2.Tooltip) end
			local topLine=newInst("Frame",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,ZIndex=4,Parent=row})
			newInst("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
				Text=cfg2.Name or "Input",TextColor3=C.textMain,
				TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham,TextSize=12,ZIndex=4,Parent=topLine})
			local box=newInst("TextBox",{Size=UDim2.new(1,0,0,30),BackgroundColor3=C.inputBg,
				BorderSizePixel=0,Text=val,PlaceholderText=cfg2.PlaceholderText or "Type here...",
				PlaceholderColor3=C.textDim,TextColor3=C.textLight,Font=Enum.Font.Gotham,TextSize=11,
				ZIndex=4,ClearTextOnFocus=false,Parent=row});corner(8,box)
			local boxStroke=stroke(C.border,1,box);padding(0,0,8,8,box)
			box.Focused:Connect(function() tw(boxStroke,{Color=C.accent,Thickness=1.5},0.15) end)
			box.FocusLost:Connect(function() tw(boxStroke,{Color=C.border,Thickness=1},0.15) end)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				val=box.Text;if cfg2.Flag then flags[cfg2.Flag]=val end
				if cfg2.Callback then cfg2.Callback(val) end;triggerAutoSave()
			end)
			if cfg2.RemoveTextAfterFocusLost then
				box.FocusLost:Connect(function() box.Text="";val="";if cfg2.Flag then flags[cfg2.Flag]="" end end)
			end
			if cfg2.Flag then
				table.insert(saveItems,{flag=cfg2.Flag,setter=function(v)
					box.Text=tostring(v);val=tostring(v);if cfg2.Flag then flags[cfg2.Flag]=val end
				end})
			end
			local obj={}
			function obj:Set(v) box.Text=tostring(v);val=tostring(v);if cfg2.Flag then flags[cfg2.Flag]=val end end
			function obj:Get() return val end
			return obj
		end

		-- Label
		function tabObj:CreateLabel(txt,_icon,col)
			col=col or C.textMain
			local lbl=newInst("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,
				Text=tostring(txt),TextColor3=col,TextXAlignment=Enum.TextXAlignment.Left,
				Font=Enum.Font.Gotham,TextSize=11,ZIndex=3,Parent=tabContainer});padding(0,0,6,0,lbl)
			local obj={}
			function obj:Set(newTxt,_i,newCol)
				lbl.Text=tostring(newTxt);if newCol then lbl.TextColor3=newCol end
			end
			return obj
		end

		-- Paragraph
		function tabObj:CreateParagraph(cfg2)
			cfg2=cfg2 or {}
			local row=makeRow(nil,true);padding(10,10,12,12,row);listLayout(row,4)
			table.insert(allElements,{frame=row,name=cfg2.Title or "Paragraph"})
			newInst("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,
				Text=cfg2.Title or "",TextColor3=C.textMain,TextXAlignment=Enum.TextXAlignment.Left,
				Font=Enum.Font.GothamBold,TextSize=12,ZIndex=4,Parent=row})
			-- Rich turns the content into token markup: {c:#9be7ff}..{/c},
			-- {b}..{/b}, {i}..{/i}, {code}..{/code}
			local rich=cfg2.Rich==true
			local contentLbl=newInst("TextLabel",{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1,
				Text=rich and parseRich(cfg2.Content) or (cfg2.Content or ""),
				RichText=rich,
				TextColor3=C.textDim,TextXAlignment=Enum.TextXAlignment.Left,
				TextWrapped=true,Font=Enum.Font.Gotham,TextSize=11,AutomaticSize=Enum.AutomaticSize.Y,ZIndex=4,Parent=row})
			local obj={}
			function obj:Set(newCfg)
				if newCfg.Content then
					contentLbl.Text=rich and parseRich(newCfg.Content) or newCfg.Content
				end
			end
			return obj
		end

		-- SectionLabel (click to fold everything below it)
		function tabObj:CreateSectionLabel(txt)
			local header=newInst("TextButton",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,
				Text="",AutoButtonColor=false,ZIndex=3,Parent=tabContainer})
			local chev=newInst("TextLabel",{Size=UDim2.new(0,10,0,10),Position=UDim2.new(0,3,0.5,-5),
				BackgroundTransparency=1,Text="v",TextColor3=C.textDim,
				Font=Enum.Font.GothamBold,TextSize=9,ZIndex=4,Parent=header})
			newInst("TextLabel",{Size=UDim2.new(1,-18,1,0),Position=UDim2.new(0,17,0,0),
				BackgroundTransparency=1,Text=txt,TextColor3=C.textDim,
				TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold,
				TextSize=9,ZIndex=3,Parent=header})
			local section={rows={},open=true}
			currentSection=section
			table.insert(allElements,{frame=header,name=txt or "Section",isSection=true,rows=section.rows})
			header.MouseEnter:Connect(function() tw(chev,{TextColor3=C.accent},0.15) end)
			header.MouseLeave:Connect(function() tw(chev,{TextColor3=C.textDim},0.15) end)
			header.MouseButton1Click:Connect(function()
				section.open=not section.open
				chev.Text=section.open and "v" or ">"
				for _,r in ipairs(section.rows) do
					if section.open then r.Visible=true end
					alphaRow(r,not section.open,0.16)
				end
				if not section.open then
					task.delay(0.18,function()
						if not section.open then
							for _,r in ipairs(section.rows) do r.Visible=false end
						end
					end)
				end
			end)
			return section
		end

		return tabObj
	end

	-- ── Window-level methods ───────────────────────────────────────────────────
	function winObj:GetFlag(flag) return flags[flag] end

	function winObj:Notify(title2,content2,col2)
		if typeof(content2)=="Color3" then col2=content2;content2="" end
		notify(tostring(title2 or "Notification"),tostring(content2 or ""),col2 or C.accent)
	end

	function winObj:SaveConfiguration()
		if not configEnabled then notify("Config","Configuration saving not enabled.",C.red);return false end
		local ok=saveConfig(CONFIG_FILE)
		notify("Config",ok and "Saved successfully!" or "Save failed!",ok and C.green or C.red)
		return ok
	end

	function winObj:LoadConfiguration()
		if not configEnabled then notify("Config","Configuration saving not enabled.",C.red);return false end
		local data=readConfig(CONFIG_FILE)
		if not data then notify("Config","No save file found",C.red);return false end
		applyConfig(data)
		showConfigBanner(win)
		return true
	end

	function winObj:SaveConfigurationTo(name)
		local ok=saveConfig(configPath(name))
		notify("Config",ok and ("Saved "..tostring(name)) or "Save failed",ok and C.green or C.red)
		return ok
	end

	function winObj:LoadConfigurationFrom(name)
		local ok=applyConfig(readConfig(configPath(name)))
		if ok then showConfigBanner(win) else notify("Config","Could not read "..tostring(name),C.red) end
		return ok
	end

	function winObj:IsConfigurationDirty()
		return isDirty()
	end

	function winObj:SetUIScale(s)
		uiScale=math.clamp(tonumber(s) or 1,0.7,1.4)
		if saveSession then saveSession() end
		uiScaleObj.Scale=uiScale
		glowScaleObj.Scale=uiScale
		if not dragging then
			win.Position=UDim2.new(0.5,-220*uiScale,0.5,-245*uiScale)
			glowFrame.Position=UDim2.new(0.5,-229*uiScale,0.5,-255*uiScale)
		end
		return uiScale
	end

	function winObj:GetUIScale() return uiScale end

	-- Live theme switch: copy the palette into C, then repaint everything that
	-- already exists instead of asking the caller to rebuild the UI.
	function winObj:SetTheme(name)
		name=tostring(name or "")
		if not THEMES[name] then
			notify("Theme","Unknown theme: "..name,C.red)
			return false
		end
		if name==currentTheme then return true end
		local old={}
		for k,v in pairs(C) do old[k]=v end
		applyTheme(name)
		retint(screen,old)
		notify("Theme","Switched to "..name,C.accent)
		triggerAutoSave()
		if saveSession then saveSession() end
		return true
	end

	function winObj:GetTheme() return currentTheme end

	function winObj:CreateHUD(hcfg)
		if hudCtrl then return hudCtrl end
		hudCtrl=buildHUD(hcfg)
		return hudCtrl
	end

	function winObj:GetHUD() return hudCtrl end

	function winObj:GetThemes()
		local out={}
		for k in pairs(THEMES) do table.insert(out,k) end
		table.sort(out)
		return out
	end

	function winObj:SetCompact(on)
		if setCompact then setCompact(on==true) end
	end

	function winObj:IsCompact() return minimized end

	-- names of tabs holding at least one flag away from its default
	function winObj:GetChangedTabs()
		local out={}
		for _,e in ipairs(tabEntries) do
			if e.changed and e.changed()>0 then table.insert(out,e.tabName) end
		end
		return out
	end

	function winObj:GetNotificationHistory() return notifHistory end

	function winObj:Destroy()
		_G.__AurixUI_Running=nil;screen:Destroy()
	end

	return winObj
end

return AurixUI

					lb.MouseButton1Click:Connect(function()
						if applyConfig(readConfig(configPath(name))) then
							notify("Config", name .. " loaded", C.green)
						else
							notify("Config", "Could not read " .. name, C.red)
						end
					end)
					local armed = false
					db.MouseButton1Click:Connect(function()
						if not armed then
							armed = true; db.Text = "Sure?"; db.TextColor3 = C.yellow
							task.delay(2, function()
								if armed and db.Parent then armed = false; db.Text = "Del"; db.TextColor3 = C.red end
							end)
							return
						end
						armed = false; db.Text = "Del"; db.TextColor3 = C.red
						deleteConfig(name)
						notify("Config", name .. " deleted", C.red)
						refresh()
					end)
				end
			end

			saveBtn.MouseButton1Click:Connect(function()
				local name = nameBox.Text:gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
				if name == "" then name = tostring(game.PlaceId) end
				if saveConfig(configPath(name)) then
					nameBox.Text = ""
					notify("Config", name .. " saved", C.green)
					refresh()
				else
					notify("Config", "Save failed", C.red)
				end
			end)

			onTheme(function()
				headLbl.TextColor3 = C.textMain
				nameBox.BackgroundColor3 = C.inputBg
				nameBox.TextColor3 = C.textMain
				nameBox.PlaceholderColor3 = C.textDim
				nbStroke.Color = C.rowStroke
				saveBtn.BackgroundColor3 = C.accent
				saveBtn.TextColor3 = C.tabSelText
			end)

			refresh()
			task.spawn(function()
				while not destroyed and row.Parent do
					dirtyDot.Visible = isDirty()
					task.wait(0.6)
				end
			end)
			local obj = {}
			function obj:Refresh() refresh() end
			return obj
		end

		-- ==== INPUT ====
		function tabObj:CreateInput(cfg2)
			cfg2 = cfg2 or {}
			local val = cfg2.CurrentValue or ""
			if cfg2.Flag then flags[cfg2.Flag] = val end
			local row = makeRow(nil, true)
			padding(10, 10, 14, 14, row)
			listLayout(row, 6)
			table.insert(allElements, { frame = row, name = cfg2.Name or "Input" })
			if cfg2.Tooltip then attachTooltip(row, cfg2.Tooltip) end

			local nameLbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
				Text = cfg2.Name or "Input", TextColor3 = C.textMain,
				TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamMedium, TextSize = 13, ZIndex = 5, Parent = row,
			})
			local box = newInst("TextBox", {
				Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.inputBg, BorderSizePixel = 0,
				Text = val, PlaceholderText = cfg2.PlaceholderText or "Type here...",
				PlaceholderColor3 = C.textDim, TextColor3 = C.textMain,
				Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false, ZIndex = 5, Parent = row,
			})
			corner(9, box)
			local boxStroke = stroke(C.rowStroke, 1, box, 0.35)
			padding(0, 0, 10, 10, box)

			box.Focused:Connect(function() tw(boxStroke, { Color = C.accent, Transparency = 0 }, 0.16) end)
			box.FocusLost:Connect(function()
				tw(boxStroke, { Color = C.rowStroke, Transparency = 0.35 }, 0.16)
				if cfg2.RemoveTextAfterFocusLost then
					box.Text = ""; val = ""
					if cfg2.Flag then flags[cfg2.Flag] = "" end
				end
			end)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				val = box.Text
				if cfg2.Flag then flags[cfg2.Flag] = val end
				if cfg2.Callback then pcall(cfg2.Callback, val) end
				triggerAutoSave()
			end)
			onTheme(function()
				nameLbl.TextColor3 = C.textMain
				box.BackgroundColor3 = C.inputBg
				box.TextColor3 = C.textMain
				box.PlaceholderColor3 = C.textDim
				boxStroke.Color = box:IsFocused() and C.accent or C.rowStroke
			end)

			if cfg2.Flag then
				table.insert(saveItems, {
					flag = cfg2.Flag,
					setter = function(v)
						box.Text = tostring(v); val = tostring(v)
						if cfg2.Flag then flags[cfg2.Flag] = val end
					end,
				})
			end
			local obj = {}
			function obj:Set(v) box.Text = tostring(v); val = tostring(v); if cfg2.Flag then flags[cfg2.Flag] = val end end
			function obj:Get() return val end
			return obj
		end

		-- ==== LABEL ====
		function tabObj:CreateLabel(txt, _icon, col)
			local customCol = col
			local card = newInst("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = C.bgDeep, BackgroundTransparency = 0.25,
				BorderSizePixel = 0, ZIndex = 4, Parent = tabContainer,
			})
			corner(10, card)
			local cs = stroke(C.rowStroke, 1, card, 0.55)
			padding(8, 8, 12, 12, card)
			local lbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, Text = tostring(txt), TextColor3 = customCol or C.textLight,
				TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.Gotham, TextSize = 11, ZIndex = 5, Parent = card,
			})
			if currentSection then table.insert(currentSection.rows, card) end
			onTheme(function()
				card.BackgroundColor3 = C.bgDeep
				cs.Color = C.rowStroke
				if not customCol then lbl.TextColor3 = C.textLight end
			end)
			local obj = {}
			function obj:Set(newTxt, _i, newCol)
				lbl.Text = tostring(newTxt)
				if newCol then customCol = newCol; lbl.TextColor3 = newCol end
			end
			return obj
		end

		-- ==== PARAGRAPH ====
		function tabObj:CreateParagraph(cfg2)
			cfg2 = cfg2 or {}
			local card = newInst("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = C.bgDeep, BackgroundTransparency = 0.15,
				BorderSizePixel = 0, ZIndex = 4, Parent = tabContainer,
			})
			corner(12, card)
			local cs = stroke(C.rowStroke, 1, card, 0.45)
			padding(10, 10, 14, 14, card)
			listLayout(card, 4)
			if currentSection then table.insert(currentSection.rows, card) end
			table.insert(allElements, { frame = card, name = cfg2.Title or "Paragraph" })

			local tLbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 17), BackgroundTransparency = 1,
				Text = cfg2.Title or "", TextColor3 = C.textMain,
				TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 5, Parent = card,
			})
			local rich = cfg2.Rich == true
			local cLbl = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Text = rich and parseRich(cfg2.Content) or (cfg2.Content or ""),
				RichText = rich, TextColor3 = C.textDim, TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 11, ZIndex = 5, Parent = card,
			})
			onTheme(function()
				card.BackgroundColor3 = C.bgDeep
				cs.Color = C.rowStroke
				tLbl.TextColor3 = C.textMain
				cLbl.TextColor3 = C.textDim
			end)
			local obj = {}
			function obj:Set(newCfg)
				if newCfg.Title then tLbl.Text = tostring(newCfg.Title) end
				if newCfg.Content then cLbl.Text = rich and parseRich(newCfg.Content) or tostring(newCfg.Content) end
			end
			return obj
		end

		-- ==== SECTION LABEL (collapsible) + CreateSection alias ====
		function tabObj:CreateSectionLabel(txt)
			local header = newInst("TextButton", {
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 4,
				Parent = tabContainer,
			})
			local accentDot = newInst("Frame", {
				Size = UDim2.fromOffset(3, 12),
				Position = UDim2.new(0, 2, 0.5, -6),
				BackgroundColor3 = C.accent,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = header,
			})
			corner(99, accentDot)
			local lbl = newInst("TextLabel", {
				Size = UDim2.new(1, -34, 1, 0),
				Position = UDim2.new(0, 11, 0, 0),
				BackgroundTransparency = 1,
				Text = string.upper(tostring(txt or "Section")),
				TextColor3 = C.textDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				ZIndex = 5,
				Parent = header,
			})
			local chev = newInst("TextLabel", {
				Size = UDim2.fromOffset(16, 16),
				Position = UDim2.new(1, -18, 0.5, -8),
				BackgroundTransparency = 1,
				Text = "v",
				TextColor3 = C.textDim,
				Font = Enum.Font.GothamBold,
				TextSize = 9,
				ZIndex = 5,
				Parent = header,
			})
			onTheme(function()
				accentDot.BackgroundColor3 = C.accent
				lbl.TextColor3 = C.textDim
				chev.TextColor3 = C.textDim
			end)

			local section = { rows = {}, open = true }
			currentSection = section
			table.insert(allElements, { frame = header, name = tostring(txt or "Section"), isSection = true, rows = section.rows })

			header.MouseEnter:Connect(function() tw(chev, { TextColor3 = C.accent }, 0.14) end)
			header.MouseLeave:Connect(function() tw(chev, { TextColor3 = C.textDim }, 0.14) end)
			header.MouseButton1Click:Connect(function()
				section.open = not section.open
				tw(chev, { Rotation = section.open and 0 or -90 }, 0.2)
				for _, r in ipairs(section.rows) do
					r.Visible = section.open
				end
			end)
			function section:Set(newTxt) lbl.Text = string.upper(tostring(newTxt)) end
			return section
		end

		tabObj.CreateSection = tabObj.CreateSectionLabel

		-- ==== DIVIDER ====
		function tabObj:CreateDivider()
			local div = newInst("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = C.rowStroke,
				BackgroundTransparency = 0.45,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = tabContainer,
			})
			if currentSection then table.insert(currentSection.rows, div) end
			onTheme(function() div.BackgroundColor3 = C.rowStroke end)
			local obj = {}
			function obj:Set(v) div.Visible = (v == true) end
			return obj
		end

		return tabObj
	end

	-- ==== WINDOW METHODS ====
	setThemeInternal = function(name)
		name = tostring(name or ""):lower()
		if not THEMES[name] then
			notify("Theme", "Unknown theme: " .. name, C.red)
			return false
		end
		if name == currentTheme then return true end
		applyPalette(name)
		fireThemeUpdate()
		notify("Theme", "Switched to " .. name, C.accent, 2.2)
		triggerAutoSave()
		if saveSession then saveSession() end
		return true
	end

	function winObj:GetFlag(flag) return flags[flag] end

	function winObj:Notify(title2, content2, col2)
		if type(title2) == "table" then
			notify(title2.Title or "Notification", title2.Content or "", title2.Color or C.accent, title2.Duration)
			return
		end
		if typeof(content2) == "Color3" then col2 = content2; content2 = "" end
		notify(tostring(title2 or "Notification"), tostring(content2 or ""), col2 or C.accent)
	end

	function winObj:SaveConfiguration()
		if not configEnabled then notify("Config", "Configuration saving not enabled.", C.red); return false end
		local ok = saveConfig(CONFIG_FILE)
		notify("Config", ok and "Saved!" or "Save failed!", ok and C.green or C.red)
		return ok
	end

	function winObj:LoadConfiguration()
		if not configEnabled then notify("Config", "Configuration saving not enabled.", C.red); return false end
		local data = readConfig(CONFIG_FILE)
		if not data then notify("Config", "No save file found", C.red); return false end
		applyConfig(data)
		showConfigBanner(win)
		return true
	end

	function winObj:SaveConfigurationTo(name)
		local ok = saveConfig(configPath(name))
		notify("Config", ok and ("Saved " .. tostring(name)) or "Save failed", ok and C.green or C.red)
		return ok
	end

	function winObj:LoadConfigurationFrom(name)
		local ok = applyConfig(readConfig(configPath(name)))
		if ok then showConfigBanner(win) else notify("Config", "Could not read " .. tostring(name), C.red) end
		return ok
	end

	function winObj:IsConfigurationDirty() return isDirty() end

	function winObj:SetUIScale(s)
		if s == nil or s == "auto" then
			manualScale = nil
		else
			manualScale = math.clamp(tonumber(s) or 1, 0.65, 1.4)
		end
		applyViewportFit(false)
		refreshScaleReadout()
		if saveSession then saveSession() end
		return uiScale
	end

	function winObj:GetUIScale() return uiScale end
	function winObj:SetTheme(name) return setThemeInternal(name) end
	function winObj:GetTheme() return currentTheme end
	function winObj:GetThemes()
		local out = {}
		for k in pairs(THEMES) do table.insert(out, k) end
		table.sort(out)
		return out
	end

	function winObj:CreateHUD(hcfg)
		if hudCtrl then return hudCtrl end
		hudCtrl = buildHUD(hcfg)
		return hudCtrl
	end
	function winObj:GetHUD() return hudCtrl end
	function winObj:SetCompact(on) setCompact(on == true) end
	function winObj:IsCompact() return minimized end
	function winObj:SetVisibility(visible)
		if visible then showUI() else hideUI() end
	end
	function winObj:IsVisible() return not hidden end

	function winObj:GetChangedTabs()
		local out = {}
		for _, e in ipairs(tabEntries) do
			if e.changed and e.changed() > 0 then table.insert(out, e.tabName) end
		end
		return out
	end

	function winObj:GetNotificationHistory() return notifHistory end

	function winObj:Destroy()
		destroyed = true
		disconnectAll()
		_G.__AurixUI_Running = nil
		if screen.Parent then screen:Destroy() end
	end

	return winObj
end

return AurixUI

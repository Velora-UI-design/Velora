				s=math.clamp((px-sv.AbsolutePosition.X)/math.max(sv.AbsoluteSize.X,1),0,1)
				v=1-math.clamp((py-sv.AbsolutePosition.Y)/math.max(sv.AbsoluteSize.Y,1),0,1)
				setColor(Color3.fromHSV(h,math.max(s,0.001),math.max(v,0.001)),false)
			end

			sv.InputBegan:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					dragging=true;grabSV(i.Position.X,i.Position.Y)
				end
			end)
			input.InputChanged:Connect(function(i)
				if not dragging then return end
				if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
					grabSV(i.Position.X,i.Position.Y)
				end
			end)
			input.InputEnded:Connect(function(i)
				if not dragging then return end
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					dragging=false
					if cfg2.Callback then cfg2.Callback(cur) end
					if sendNotif then notify(cfg2.Name or "Color",hexOf(cur),C.accent) end
					triggerAutoSave()
				end
			end)

			local function grabHue(py)
				local rel=math.clamp((py-hueBar.AbsolutePosition.Y)/math.max(hueBar.AbsoluteSize.Y,1),0,1)
				setColor(Color3.fromHSV(rel,math.max(s,0.001),math.max(v,0.001)),false)
			end
			local hueDrag=false
			hueBar.InputBegan:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					hueDrag=true;grabHue(i.Position.Y)
				end
			end)
			input.InputChanged:Connect(function(i)
				if not hueDrag then return end
				if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
					grabHue(i.Position.Y)
				end
			end)
			input.InputEnded:Connect(function(i)
				if not hueDrag then return end
				if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
					hueDrag=false
					if cfg2.Callback then cfg2.Callback(cur) end
					if sendNotif then notify(cfg2.Name or "Color",hexOf(cur),C.accent) end
					triggerAutoSave()
				end
			end)

			hexBox.FocusLost:Connect(function()
				local txt=hexBox.Text:gsub("%s",""):gsub("#","")
				local r,g,b=txt:match("^(%x%x)(%x%x)(%x%x)$")
				if r then
					local c=Color3.fromRGB(tonumber(r,16),tonumber(g,16),tonumber(b,16))
					setColor(c,true)
				else
					hexBox.Text=hexOf(cur)
				end
			end)

			setColor(cur,false)
			if cfg2.Flag then
				table.insert(saveItems,{flag=cfg2.Flag,setter=function(v2)
					if type(v2)~="string" then return end
					local r,g,b=tostring(v2):match("^(%d+),(%d+),(%d+)$")
					if r then setColor(Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b)),false) end
				end})
			end
			local obj={}
			function obj:Set(c) setColor(c,false) end
			function obj:Get() return cur end
			return obj
		end

		-- Keybind
		function tabObj:CreateKeybind(cfg2)
			cfg2=cfg2 or {}
			local curKey=cfg2.CurrentKey
			local listening=false
			local listenAt=0
			if cfg2.Flag then flags[cfg2.Flag]=curKey and curKey.Name or "None" end

			local row=makeRow(48);rowLabel(cfg2.Name or "Keybind",cfg2.Description,row)
			table.insert(allElements,{frame=row,name=cfg2.Name or "Keybind"})
			if cfg2.Tooltip then attachTooltip(row,cfg2.Tooltip) end

			local btn=newInst("TextButton",{Size=UDim2.new(0,96,0,30),Position=UDim2.new(1,-124,0.5,-15),
				BackgroundColor3=Color3.fromRGB(14,33,46),BorderSizePixel=0,Text="None",
				TextColor3=C.textLight,Font=Enum.Font.GothamBold,TextSize=11,
				AutoButtonColor=false,ZIndex=4,Parent=row});corner(8,btn);stroke(C.border,1,btn)

			local clear=newInst("TextButton",{Size=UDim2.new(0,18,0,18),Position=UDim2.new(1,-24,0.5,-9),
				BackgroundColor3=Color3.fromRGB(14,33,46),BorderSizePixel=0,Text="x",
				TextColor3=C.textDim,Font=Enum.Font.GothamBold,TextSize=11,
				AutoButtonColor=false,ZIndex=4,Parent=row});corner(6,clear);stroke(C.border,1,clear)

			local function keyName()
				if not curKey then return "None" end
				return curKey.Name
			end
			local function setKey(k,fire)
				curKey=k
				btn.Text=keyName()
				if cfg2.Flag then flags[cfg2.Flag]=keyName() end
				-- release whatever this row held, then claim the new key
				for n,o in pairs(keyOwners) do if o.id==row then keyOwners[n]=nil end end
				if k then
					local nm=keyName()
					local other=keyOwners[nm]
					if other and other.id~=row and other.row and other.row.Parent then
						local os=other.row:FindFirstChildOfClass("UIStroke")
						if os then
							tw(os,{Color=C.red,Thickness=1.6},0.12)
							task.delay(1.2,function()
								if os.Parent then tw(os,{Color=C.border,Thickness=1},0.3) end
							end)
						end
						-- only warn on a real user action, not on a load
						if fire then
							notify("Keybind conflict",nm.." is already bound to "..other.name,C.yellow)
						end
					end
					keyOwners[nm]={id=row,row=row,name=cfg2.Name or "Keybind"}
				end
				if fire then
					if cfg2.Callback then cfg2.Callback(k) end
					triggerAutoSave()
				end
			end

			btn.MouseButton1Click:Connect(function()
				listening=true;listenAt=os.clock()
				btn.Text="  press key"
				btn.TextColor3=C.yellow
			end)
			clear.MouseButton1Click:Connect(function()
				listening=false
				btn.TextColor3=C.textLight
				setKey(nil,true)
			end)

			input.InputBegan:Connect(function(i,gp)
				if not listening then return end
				if os.clock()-listenAt<0.15 then return end
				if i.UserInputType==Enum.UserInputType.Keyboard then
					listening=false
					btn.TextColor3=C.textLight
					if i.KeyCode==Enum.KeyCode.Escape then setKey(nil,true) else setKey(i.KeyCode,true) end
				elseif i.UserInputType==Enum.UserInputType.MouseButton2
					or i.UserInputType==Enum.UserInputType.MouseButton3 then
					listening=false
					btn.TextColor3=C.textLight
					setKey(i.UserInputType,true)
				end
			end)

			clear.MouseEnter:Connect(function() tw(clear,{BackgroundColor3=Color3.fromRGB(40,18,26)},0.12) end)
			clear.MouseLeave:Connect(function() tw(clear,{BackgroundColor3=Color3.fromRGB(14,33,46)},0.12) end)

			setKey(curKey,false)
			if cfg2.Flag then
				table.insert(saveItems,{flag=cfg2.Flag,setter=function(v)
					if type(v)~="string" or v=="None" then setKey(nil,false);return end
					-- Enum lookups throw on unknown names, so probe both safely
					local k=nil
					pcall(function() k=Enum.KeyCode[v] end)
					if not k then pcall(function() k=Enum.UserInputType[v] end) end
					if k then setKey(k,false) end
				end})
			end
			local obj={}
			function obj:Set(k) setKey(k,false) end
			function obj:Get() return curKey end
			return obj
		end


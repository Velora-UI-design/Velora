-- ── Loading screen ────────────────────────────────────────────────────────────
-- Continuous eased progress driven per frame. No stepped tweens, so the fill
-- never stutters and never restarts mid tween.
local LOAD_SEGS = {
	{0.00,0.16,  0, 12},
	{0.16,0.30, 12, 34},
	{0.30,0.42, 34, 37},
	{0.42,0.66, 37, 71},
	{0.66,0.78, 71, 75},
	{0.78,1.00, 75,100},
}
local LOAD_STAGES = {
	{0,  "Initializing"},
	{14, "Loading modules"},
	{38, "Applying theme"},
	{70, "Building interface"},
	{94, "Ready"},
}

local function loadEase(t)
	if t<0.5 then return 4*t*t*t end
	return 1-((-2*t+2)^3)/2
end

local function loadProgress(t)
	for _,s in ipairs(LOAD_SEGS) do
		if t<=s[2] then
			local k=math.clamp((t-s[1])/(s[2]-s[1]),0,1)
			return s[3]+(s[4]-s[3])*loadEase(k)
		end
	end
	return 100
end

local function fadeTree(root,dur)
	for _,c in ipairs(root:GetDescendants()) do
		if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
			tw(c,{TextTransparency=1,BackgroundTransparency=1},dur)
		elseif c:IsA("ImageLabel") or c:IsA("ImageButton") then
			tw(c,{ImageTransparency=1,BackgroundTransparency=1},dur)
		elseif c:IsA("Frame") then
			tw(c,{BackgroundTransparency=1},dur)
		elseif c:IsA("UIStroke") then
			tw(c,{Transparency=1},dur)
		end
	end
end


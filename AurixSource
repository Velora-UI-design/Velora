		tw(card,{BackgroundTransparency=1,Position=UDim2.new(0.5,-W/2,0.45,-H/2)},0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
		tw(overlay,{BackgroundTransparency=1},0.3)
		task.delay(0.35,function() overlay:Destroy();if cb then cb() end end)
	end

	local processing=false
	local function tryValidate(entered)
		entered=(entered or ""):match("^%s*(.-)%s*$")
		if entered=="" then setStatus("Enter a key first","warning");shakeCard();return end
		if processing then return end
		processing=true;redeemLbl.Text="Checking..."
		tw(redeemBtn,{BackgroundColor3=Color3.fromRGB(60,148,200)},0.15)
		task.spawn(function()
			local keys=resolveKeys();local valid=false
			for _,k in ipairs(keys) do if entered==k then valid=true;break end end
			if valid then
				setStatus("Key accepted! Loading...","success")
				tw(redeemBtn,{BackgroundColor3=Color3.fromRGB(28,110,55)},0.2)
				tw(inputStroke,{Color=C.green},0.2)
				redeemLbl.Text="✓ Accepted"
				if saveKey then
					ensureFolder(CONFIG_FOLDER)
					pcall(function() writefile(keyFile,entered) end)
				end
				task.delay(0.9,function() dismissCard(onSuccess) end)
			else
				attempts=attempts+1
				if attempts>=maxAtt then
					setStatus("No attempts remaining","error")
					task.delay(1.2,function() Players.LocalPlayer:Kick("[AurixUI] Invalid key.") end)
				else
					setStatus("Invalid key. "..(maxAtt==math.huge and "" or (maxAtt-attempts).." attempts left"),"error")
					tw(inputStroke,{Color=C.red},0.15)
					shakeCard()
					task.delay(0.6,function() tw(inputStroke,{Color=C.border},0.3) end)
					redeemLbl.Text="Redeem Key";tw(redeemBtn,{BackgroundColor3=C.accent},0.2)
				end
				processing=false
			end
		end)
	end

	getKeyBtn.MouseButton1Click:Connect(function()
		if getKeyUrl then pcall(function() setclipboard(getKeyUrl) end);setStatus("Link copied to clipboard!","warning")
		else setStatus("No key URL set by the script author.","error") end
	end)
	redeemBtn.MouseButton1Click:Connect(function() tryValidate(keyBox.Text) end)
	keyBox.FocusLost:Connect(function(enter) if enter then tryValidate(keyBox.Text) end end)

	-- hover states
	getKeyBtn.MouseEnter:Connect(function() tw(getKeyBtn,{BackgroundColor3=Color3.fromRGB(18,36,46)},0.12) end)
	getKeyBtn.MouseLeave:Connect(function() tw(getKeyBtn,{BackgroundColor3=Color3.fromRGB(12,26,34)},0.12) end)
	redeemBtn.MouseEnter:Connect(function() tw(redeemBtn,{BackgroundColor3=Color3.fromRGB(80,164,220)},0.12) end)

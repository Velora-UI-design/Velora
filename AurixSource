		Position = UDim2.new(0, 16, 1, -40),
		BackgroundTransparency = 1,
		Text = keyCfg.Note or "discord.gg/ssMNdW62D7",
		TextColor3 = C.textDim,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 402,
		Parent = card,
	})

	tw(card, { BackgroundTransparency = 0, Position = UDim2.new(0.5, 0, 0.5, 0) }, 0.4)

	local function resolveKeys()
		local out = {}
		for _, k in ipairs(validKeys) do
			if type(k) == "string" and k:sub(1, 4) == "http" and keyCfg.GrabKeyFromSite then
				local ok, r = pcall(function() return game:HttpGet(k) end)
				if ok then table.insert(out, r:match("^%s*(.-)%s*$")) end
			else
				table.insert(out, k)
			end
		end
		return out
	end

	local function dismissCard(cb)
		tw(card, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.46, 0) }, 0.25)
		tw(overlay, { BackgroundTransparency = 1 }, 0.28)
		task.delay(0.3, function()
			if overlay.Parent then overlay:Destroy() end
			if cb then cb() end
		end)
	end

	local processing = false
	local function tryValidate(entered)
		entered = (entered or ""):match("^%s*(.-)%s*$")
		if entered == "" then setStatus("Enter a key first", "warning"); return end
		if processing then return end
		processing = true
		redeemBtn.Text = "Checking..."
		task.spawn(function()
			local keys = resolveKeys()
			local valid = false
			for _, k in ipairs(keys) do if entered == k then valid = true; break end end
			if valid then
				setStatus("Key accepted", "success")
				tw(redeemBtn, { BackgroundColor3 = C.green }, 0.2)
				redeemBtn.Text = "Accepted"
				if saveKey then
					ensureFolder(CONFIG_FOLDER)
					pcall(function() writefile(keyFile, entered) end)
				end
				task.delay(0.7, function() dismissCard(onSuccess) end)
			else
				attempts = attempts + 1
				if attempts >= maxAtt then
					setStatus("No attempts left", "error")
					task.delay(1, function() Players.LocalPlayer:Kick("[AurixUI] Invalid key.") end)
				else
					setStatus("Invalid key", "error")
					tw(inputStroke, { Color = C.red, Transparency = 0 }, 0.15)
					task.delay(0.6, function() tw(inputStroke, { Color = C.rowStroke, Transparency = 0.25 }, 0.3) end)
					redeemBtn.Text = "Redeem Key"
				end
				processing = false
			end
		end)
	end

	getKeyBtn.MouseButton1Click:Connect(function()
		if getKeyUrl then
			pcall(function() setclipboard(getKeyUrl) end)
			setStatus("Key link copied", "warning")
		else
			setStatus("No key URL set", "error")
		end
	end)
	redeemBtn.MouseButton1Click:Connect(function() tryValidate(keyBox.Text) end)
	keyBox.FocusLost:Connect(function(enter) if enter then tryValidate(keyBox.Text) end end)
end

-- ==== RICH TEXT ====
local function escRich(s)
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	return s
end

local function parseRich(txt)
	local s = escRich(tostring(txt or ""))
	s = s:gsub("{c:([#%w]+)}", '<font color="%1">'):gsub("{/c}", "</font>")
	s = s:gsub("{b}", "<b>"):gsub("{/b}", "</b>")
	s = s:gsub("{i}", "<i>"):gsub("{/i}", "</i>")
	s = s:gsub("{code}", '<font name="RobotoMono">'):gsub("{/code}", "</font>")
	return s
end


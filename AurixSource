		end
		if label~=curStage then curStage=label;stageLbl.Text=label end
		if elapsed>=1 then conn:Disconnect();finish() end
	end)

	-- safety net if frames stall
	task.delay(DUR+1.2,finish)
end

-- ── Ambient particles ─────────────────────────────────────────────────────────
-- Dust motes drifting over the interface. One loop for the whole window, and it
-- idles whenever the window is hidden instead of burning frames.
local function buildAmbient(win)
	local H=408
	local layer=newInst("Frame",{Name="AurixDust",Size=UDim2.new(1,0,1,-82),
		Position=UDim2.new(0,0,0,82),BackgroundTransparency=1,BorderSizePixel=0,
		ZIndex=50,ClipsDescendants=true,Parent=win})
	corner(16,layer)
	-- soft orbs first: they give the field depth, the dots do the twinkle
	local orbs={}
	for i=1,5 do
		local sz=28+math.random(0,34)
		local o=newInst("Frame",{Size=UDim2.new(0,sz,0,sz),
			BackgroundColor3=C.iceDeep,BackgroundTransparency=0.94,
			BorderSizePixel=0,ZIndex=50,Parent=layer})
		corner(99,o)
		orbs[i]={f=o,x=math.random()*440,y=math.random()*H,
			vy=2+math.random()*4,vx=(math.random()-0.5)*2,
			phase=math.random()*6.28}
	end
	local dots={}
	for i=1,24 do
		local sz=(i%4==0) and 3 or 2
		local d=newInst("Frame",{Size=UDim2.new(0,sz,0,sz),
			BackgroundColor3=(i%3==0) and C.iceDeep or C.ice,
			BackgroundTransparency=0.62,BorderSizePixel=0,ZIndex=50,Parent=layer})
		corner(99,d)
		dots[i]={f=d,x=math.random()*440,y=math.random()*H,
			vy=7+math.random()*13,vx=(math.random()-0.5)*4,
			phase=math.random()*6.28,amp=0.08+math.random()*0.08}
	end
	task.spawn(function()
		while layer.Parent do
			local dt=RunSvc.Heartbeat:Wait()
			if win.Visible then
				local t=os.clock()
				for _,o in ipairs(orbs) do
					o.y=o.y-o.vy*dt
					o.x=o.x+o.vx*dt
					if o.y<-70 then o.y=H+70;o.x=math.random()*440 end
					if o.x<-70 then o.x=450 elseif o.x>450 then o.x=-70 end
					o.f.Position=UDim2.fromOffset(math.floor(o.x),math.floor(o.y))
					o.f.BackgroundTransparency=0.94-0.02*math.sin(t*0.6+o.phase)
				end
				for _,p in ipairs(dots) do
					p.y=p.y-p.vy*dt
					p.x=p.x+p.vx*dt
					if p.y<-6 then p.y=H+6;p.x=math.random()*440 end
					if p.x<-6 then p.x=446 elseif p.x>446 then p.x=-6 end
					p.f.Position=UDim2.fromOffset(math.floor(p.x),math.floor(p.y))
					p.f.BackgroundTransparency=0.66+p.amp*math.sin(t*1.3+p.phase)
				end
			end
		end
	end)
	return layer
end

-- ── Rich text ─────────────────────────────────────────────────────────────────
-- Tokens, so a paragraph can point at a colour or a snippet without the author
-- hand-writing Roblox markup: {c:#9be7ff}..{/c}, {b}..{/b}, {i}..{/i},
-- {code}..{/code}. Braces are escaped in the source text, angle brackets are
-- escaped on the way out so a stray "<" cannot swallow the rest of the line.
local function escRich(s)
	s=s:gsub("&","&amp;")
	s=s:gsub("<","&lt;")
	s=s:gsub(">","&gt;")
	return s
end

local function parseRich(txt)
	local s=escRich(tostring(txt or ""))
	s=s:gsub("{c:([#%w]+)}",'<font color="%1">'):gsub("{/c}","</font>")
	s=s:gsub("{b}","<b>"):gsub("{/b}","</b>")
	s=s:gsub("{i}","<i>"):gsub("{/i}","</i>")
	s=s:gsub("{code}",'<font name="RobotoMono">'):gsub("{/code}","</font>")
	return s
end


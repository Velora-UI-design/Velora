		})
		hudList = newInst("Frame", {
			Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 30),
			AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 21, Parent = hudPanel,
		})
		listLayout(hudList, 5); padding(4, 8, 7, 7, hudList)

		local hdrag, hoff = false, nil
		header.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				hdrag = true; hoff = i.Position
			end
		end)
		track(UserInputService.InputChanged:Connect(function(i)
			if not hdrag then return end
			if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
			local d = i.Position - hoff; hoff = i.Position
			local vp = getViewport(screen)
			local absPx = hudPanel.AbsolutePosition
			local sz = hudPanel.AbsoluteSize
			hudPanel.Position = UDim2.fromOffset(
				math.floor(math.clamp(absPx.X + d.X, 4, math.max(4, vp.X - sz.X - 4))),
				math.floor(math.clamp(absPx.Y + d.Y, 4, math.max(4, vp.Y - sz.Y - 4)))
			)
		end))
		track(UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then hdrag = false end
		end))

		if hcfg.StartHidden == true then hudPanel.Visible = false end
		local ctrl = {}
		function ctrl:Add(key, name, get, set, value) hudItems[tostring(key)] = { name = name, get = get, set = set, value = value }; refreshHUD() end
		function ctrl:Remove(key)
			hudItems[tostring(key)] = nil
			local p = hudPills[tostring(key)]
			if p then p:Destroy(); hudPills[tostring(key)] = nil end
			refreshHUD()
		end
		function ctrl:Refresh() refreshHUD() end
		function ctrl:SetVisible(v) hudPanel.Visible = (v == true); if v then refreshHUD() end end
		function ctrl:IsVisible() return hudPanel.Visible end
		function ctrl:GetPanel() return hudPanel end
		function ctrl:Destroy() if hudPanel then hudPanel:Destroy() end; hudPanel = nil; hudList = nil; hudPills = {} end
		refreshHUD()
		return ctrl
	end

	local function hudRegister(key, item)
		if key == nil then return end
		hudItems[tostring(key)] = item
		if not hudPanel then
			local ok, ctrl = pcall(buildHUD)
			if ok then hudCtrl = ctrl end
		end
		refreshHUD()
	end


			applyViewportFit(true)
			local curH = minimized and TOPBAR_H or winH
			win.Visible = true
			shadowFrame.Visible = true
			dragBar.Visible = true
			win.Size = UDim2.fromOffset(math.max(260, winW - 28), math.max(50, curH - 28))

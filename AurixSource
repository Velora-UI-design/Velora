				Font = Enum.Font.GothamMedium,
				TextSize = 11,
				ClearTextOnFocus = false,
				ZIndex = 6,
				Parent = inner,
			})
			corner(8, hexBox)
			local hbStroke = stroke(C.rowStroke, 1, hexBox, 0.35)
			padding(0, 0, 7, 7, hexBox)

			local presets = {
				Color3.fromRGB(82, 192, 255), Color3.fromRGB(58, 218, 144), Color3.fromRGB(166, 118, 255),
				Color3.fromRGB(255, 146, 76), Color3.fromRGB(248, 204, 72), Color3.fromRGB(244, 88, 96),
			}
			local presetRow = newInst("Frame", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, 108), BackgroundTransparency = 1, ZIndex = 6, Parent = inner })
			listLayout(presetRow, 6, Enum.FillDirection.Horizontal)
			for _, pc in ipairs(presets) do
				local pb = newInst("TextButton", {
					Size = UDim2.fromOffset(22, 20), BackgroundColor3 = pc, BorderSizePixel = 0,
					Text = "", AutoButtonColor = false, ZIndex = 7, Parent = presetRow,
				})
				corner(6, pb)
				pb.MouseButton1Click:Connect(function() setColor(pc, true) end)
			end

			local function hexOf(c)
				return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
			end
			local function tripleOf(c)
				return string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
			end

			setColor = function(c, fire)
				h, s, v = c:ToHSV()
				cur = Color3.fromHSV(h, s, v)
				sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
				swatch.BackgroundColor3 = cur
				hexLbl.Text = hexOf(cur)
				if not hexBox:IsFocused() then hexBox.Text = hexOf(cur) end
				if cfg2.Flag then flags[cfg2.Flag] = tripleOf(cur) end
				if fire then
					if cfg2.Callback then pcall(cfg2.Callback, cur) end
					if sendNotif then notify(cfg2.Name or "Color", hexOf(cur), C.accent, 1.8) end
					triggerAutoSave()
				end
			end

			onTheme(function()
				nameLbl.TextColor3 = C.textMain
				hexLbl.TextColor3 = C.textDim
				hexBox.BackgroundColor3 = C.inputBg
				hexBox.TextColor3 = C.textMain
				hbStroke.Color = C.rowStroke
			end)

			top.MouseButton1Click:Connect(function()
				expanded = not expanded
				tw(body, { Size = expanded and UDim2.new(1, 0, 0, 134) or UDim2.new(1, 0, 0, 0) }, 0.28)
			end)

			local function grabSV(px, py)
				s = math.clamp((px - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				v = 1 - math.clamp((py - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				setColor(Color3.fromHSV(h, math.max(s, 0.001), math.max(v, 0.001)), false)
			end
			local function grabHue(py)
				local rel = math.clamp((py - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
				setColor(Color3.fromHSV(rel, math.max(s, 0.001), math.max(v, 0.001)), false)
			end

			sv.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					svDrag = true; grabSV(i.Position.X, i.Position.Y)
				end
			end)
			hueBar.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					hueDrag = true; grabHue(i.Position.Y)
				end
			end)
			track(UserInputService.InputChanged:Connect(function(i)
				if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
				if svDrag then grabSV(i.Position.X, i.Position.Y) end
				if hueDrag then grabHue(i.Position.Y) end
			end))
			track(UserInputService.InputEnded:Connect(function(i)
				if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
				if svDrag or hueDrag then
					svDrag = false; hueDrag = false
					if cfg2.Callback then pcall(cfg2.Callback, cur) end
					triggerAutoSave()
				end
			end))

			hexBox.FocusLost:Connect(function()
				local txt = hexBox.Text:gsub("%s", ""):gsub("#", "")
				local r, g, b = txt:match("^(%x%x)(%x%x)(%x%x)$")
				if r then
					setColor(Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)), true)
				else
					hexBox.Text = hexOf(cur)
				end
			end)

			setColor(cur, false)
			if cfg2.Flag then
				table.insert(saveItems, {
					flag = cfg2.Flag,
					setter = function(v2)
						if type(v2) ~= "string" then return end
						local r, g, b = tostring(v2):match("^(%d+),(%d+),(%d+)$")
						if r then setColor(Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)), false) end
					end,
				})
			end
			local obj = {}
			function obj:Set(c) setColor(c, false) end
			function obj:Get() return cur end
			return obj
		end

		-- ==== KEYBIND ====
		function tabObj:CreateKeybind(cfg2)
			cfg2 = cfg2 or {}
			local curKey = cfg2.CurrentKey
			if not curKey and type(cfg2.CurrentKeybind) == "string" then
				pcall(function() curKey = Enum.KeyCode[cfg2.CurrentKeybind:upper()] end)
			end
			local listening, listenAt = false, 0
			if cfg2.Flag then flags[cfg2.Flag] = curKey and curKey.Name or "None" end

			local row = makeRow(cfg2.Description and 52 or 44)
			rowLabel(cfg2.Name or "Keybind", cfg2.Description, row, 128)
			table.insert(allElements, { frame = row, name = cfg2.Name or "Keybind" })
			if cfg2.Tooltip then attachTooltip(row, cfg2.Tooltip) end

			local btn = newInst("TextButton", {
				Size = UDim2.fromOffset(82, 28),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -38, 0.5, 0),
				BackgroundColor3 = C.inputBg,
				BorderSizePixel = 0,
				Text = "None",
				TextColor3 = C.textLight,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				AutoButtonColor = false,
				ZIndex = 5,
				Parent = row,
			})
			corner(8, btn)
			local btnStroke = stroke(C.rowStroke, 1, btn, 0.35)

			local clr = newInst("TextButton", {
				Size = UDim2.fromOffset(20, 20),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				BackgroundColor3 = C.inputBg,
				BorderSizePixel = 0,
				Text = "x",
				TextColor3 = C.textDim,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				AutoButtonColor = false,
				ZIndex = 5,
				Parent = row,
			})
			corner(6, clr)
			local clrStroke = stroke(C.rowStroke, 1, clr, 0.45)

			onTheme(function()
				btn.BackgroundColor3 = C.inputBg
				btn.TextColor3 = listening and C.yellow or C.textLight
				btnStroke.Color = listening and C.accent or C.rowStroke
				clr.BackgroundColor3 = C.inputBg
				clr.TextColor3 = C.textDim
				clrStroke.Color = C.rowStroke
			end)

			local function keyName() return curKey and curKey.Name or "None" end
			local function setKey(k, fire)
				curKey = k
				btn.Text = keyName()
				if cfg2.Flag then flags[cfg2.Flag] = keyName() end
				for n, o in pairs(keyOwners) do if o.id == row then keyOwners[n] = nil end end
				if k then
					local nm = keyName()
					local other = keyOwners[nm]
					if other and other.id ~= row and other.row and other.row.Parent and fire then
						notify("Keybind conflict", nm .. " is already bound to " .. other.name, C.yellow, 2.8)
					end
					keyOwners[nm] = { id = row, row = row, name = cfg2.Name or "Keybind" }
				end
				if fire then
					if cfg2.Callback then pcall(cfg2.Callback, k) end
					triggerAutoSave()
				end
			end

			btn.MouseButton1Click:Connect(function()
				listening = true; listenAt = os.clock()
				btn.Text = "..."
				btn.TextColor3 = C.yellow
				tw(btnStroke, { Color = C.accent, Transparency = 0 }, 0.16)
			end)
			clr.MouseButton1Click:Connect(function()
				listening = false
				btn.TextColor3 = C.textLight
				tw(btnStroke, { Color = C.rowStroke, Transparency = 0.35 }, 0.16)
				setKey(nil, true)
			end)
			track(UserInputService.InputBegan:Connect(function(i)
				if not listening then return end
				if os.clock() - listenAt < 0.12 then return end
				if i.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					btn.TextColor3 = C.textLight
					tw(btnStroke, { Color = C.rowStroke, Transparency = 0.35 }, 0.16)
					if i.KeyCode == Enum.KeyCode.Escape then setKey(nil, true) else setKey(i.KeyCode, true) end
				elseif i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.MouseButton3 then
					listening = false
					btn.TextColor3 = C.textLight
					tw(btnStroke, { Color = C.rowStroke, Transparency = 0.35 }, 0.16)
					setKey(i.UserInputType, true)
				end
			end))

			setKey(curKey, false)
			if cfg2.Flag then
				table.insert(saveItems, {
					flag = cfg2.Flag,
					setter = function(v)
						if type(v) ~= "string" or v == "None" then setKey(nil, false); return end
						local k = nil
						pcall(function() k = Enum.KeyCode[v] end)
						if not k then pcall(function() k = Enum.UserInputType[v] end) end
						if k then setKey(k, false) end
					end,
				})
			end
			local obj = {}
			function obj:Set(k) setKey(k, false) end
			function obj:Get() return curKey end
			return obj
		end


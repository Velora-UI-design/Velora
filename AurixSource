		-- fade a whole row in or out without losing how it was styled
		local function alphaRow(r,hidden,dur)
			local snap=rowSnaps[r]
			if not snap then
				snap={}
				for _,c in ipairs(r:GetDescendants()) do
					local e={}
					if c:IsA("GuiObject") then e.bt=c.BackgroundTransparency end
					if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then e.tt=c.TextTransparency end
					if c:IsA("ImageLabel") or c:IsA("ImageButton") then e.it=c.ImageTransparency end
					if c:IsA("UIStroke") then e.st=c.Transparency end
					if next(e) then snap[c]=e end
				end
				rowSnaps[r]=snap
			end
			tw(r,{BackgroundTransparency=hidden and 1 or 0},dur)
			for c,e in pairs(snap) do
				if c.Parent then
					local props={}
					if e.bt~=nil then props.BackgroundTransparency=hidden and 1 or e.bt end
					if e.tt~=nil then props.TextTransparency=hidden and 1 or e.tt end
					if e.it~=nil then props.ImageTransparency=hidden and 1 or e.it end
					if e.st~=nil then props.Transparency=hidden and 1 or e.st end
					tw(c,props,dur)
				end
			end
		end


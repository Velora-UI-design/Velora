			local menuFrame=newInst("Frame",{Size=UDim2.new(1,0,0,0),BackgroundColor3=Color3.fromRGB(16,30,38),
				BorderSizePixel=0,ZIndex=5,ClipsDescendants=true,Visible=false,Parent=row})
			corner(8,menuFrame);stroke(C.border,1,menuFrame);listLayout(menuFrame,0)

			-- long lists get a filter, otherwise you scroll a menu hunting for a word
			local filterBox=nil
			if #options>(cfg2.SearchThreshold or 8) then
				filterBox=newInst("TextBox",{Size=UDim2.new(1,-10,0,26),BackgroundColor3=C.inputBg,
					BackgroundTransparency=0.35,Text="",PlaceholderText="Filter options...",
					PlaceholderColor3=C.textDim,TextColor3=C.textMain,

		-- ==== TOGGLE (whole row clickable + Rayfield Gen2 wide pill switch) ====
		function tabObj:CreateToggle(cfg2)
			cfg2 = cfg2 or {}
			local val = cfg2.CurrentValue or false
			local sendNotif = cfg2.SendNotification ~= false
			if cfg2.Flag then flags[cfg2.Flag] = val end
			local row, rowStroke = makeRow(cfg2.Description and 52 or 44)
			rowLabel(cfg2.Name or "Toggle", cfg2.Description, row, 72)
			table.insert(allElements, { frame = row, name = cfg2.Name or "Toggle" })
			if cfg2.Tooltip then attachTooltip(row, cfg2.Tooltip) end

			local track = newInst("Frame", {
				Size = UDim2.fromOffset(48, 22),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				BackgroundColor3 = C.toggleOff,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = row,
			})
			corner(99, track)
			local tStroke = stroke(C.rowStroke, 1, track, 0.35)

			local thumb = newInst("Frame", {
				Size = UDim2.fromOffset(22, 16),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 3, 0.5, 0),
				BackgroundColor3 = C.toggleKnobOff,
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = track,
			})
			corner(99, thumb)

			local function paintToggle(v, instant)
				local tPos = v and UDim2.new(0, 23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
				local tBg = v and C.accentFade or C.toggleOff
				local kBg = v and C.accent or C.toggleKnobOff
				local sCol = v and C.accent or C.rowStroke
				if instant then
					thumb.Position = tPos; thumb.BackgroundColor3 = kBg
					track.BackgroundColor3 = tBg; tStroke.Color = sCol
				else
					tw(thumb, { Position = tPos, BackgroundColor3 = kBg }, 0.24)
					tw(track, { BackgroundColor3 = tBg }, 0.24)
					tw(tStroke, { Color = sCol, Transparency = v and 0.1 or 0.35 }, 0.24)
				end
			end

			onTheme(function() paintToggle(val, true) end)

			local function setVal(v, silent)
				val = (v == true)
				if cfg2.Flag then flags[cfg2.Flag] = val end
				paintToggle(val, silent)
				if not silent then
					if cfg2.Callback then
						local ok, err = pcall(cfg2.Callback, val)
						if not ok then warn("[AurixUI] Toggle error: " .. tostring(err)) end
					end
					if sendNotif then
						notify(cfg2.Name or "Toggle", val and "Enabled" or "Disabled", val and C.green or C.red, 2.2)
					end
					syncBadge()
					triggerAutoSave()
					if cfg2.HUD then refreshHUD() end
				end
			end

			-- initial state (still fires initial callback if current value is true, matches v2 behavior)
			paintToggle(val, true)
			if cfg2.Callback and val then pcall(cfg2.Callback, val) end

			local hit = newInst("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 7,
				Parent = row,
			})
			hit.MouseButton1Click:Connect(function()
				tw(rowStroke, { Transparency = 0.85 }, 0.12)
				task.delay(0.12, function()
					if rowStroke.Parent then tw(rowStroke, { Transparency = C.isLight and 0.15 or 0.35 }, 0.2) end
				end)
				setVal(not val, false)
			end)

			if cfg2.Flag then
				table.insert(saveItems, { flag = cfg2.Flag, setter = function(v) setVal(v == true or v == "true", false) end })
			end
			local obj = {}
			function obj:Set(v) setVal(v, false) end
			function obj:Get() return val end
			if cfg2.Default ~= nil then addProbe(function() return val ~= cfg2.Default end) end
			if cfg2.HUD then
				hudRegister(cfg2.Flag or cfg2.Name, {
					name = (type(cfg2.HUD) == "string") and cfg2.HUD or (cfg2.Name or "Feature"),
					get = function() return val end,
					set = function(v2) setVal(v2 == true, false) end,
					value = cfg2.HUDValue,
				})
			end
			return obj
		end


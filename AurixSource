	local redeemBtn = newInst("TextButton", {
		Size = UDim2.new(0.55, -22, 0, 42),
		Position = UDim2.new(0.45, 6, 0, 160),
		BackgroundColor3 = C.accent,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "Redeem Key",
		TextColor3 = C.tabSelText,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		ZIndex = 402,
		Parent = card,
	})
	corner(12, redeemBtn)

	newInst("TextLabel", {

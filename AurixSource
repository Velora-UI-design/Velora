	-- debounced session save
	local sessionQueued = false
	saveSession = function()
		if sessionQueued then return end
		sessionQueued = true
		task.delay(0.7, function()
			sessionQueued = false
			pcall(function()
				ensureFolder(configFolder)
				writefile(SESSION_FILE, HttpService:JSONEncode({
					xs = win.Position.X.Scale, xo = win.Position.X.Offset,
					ys = win.Position.Y.Scale, yo = win.Position.Y.Offset,
					dragged = userDragged,
					tab = activeTab and tostring(activeTab.tabName) or nil,
					scale = uiScale, manualScale = manualScale ~= nil,
					theme = currentTheme, compact = minimized,
				}))
			end)
		end)
	end

	-- restore session safely
	if sessionData then
		if sessionData.dragged == true and tonumber(sessionData.xo) and tonumber(sessionData.yo) then
			userDragged = true
			local xs = tonumber(sessionData.xs) or 0
			local ys = tonumber(sessionData.ys) or 0
			local vp = getViewport(screen)
			local x = xs * vp.X + tonumber(sessionData.xo)
			local y = ys * vp.Y + tonumber(sessionData.yo)
			local cx, cy = clampCenterPos(x, y, winW, winH)
			win.Position = UDim2.fromOffset(cx, cy)
			syncDecor(true)
		end
		task.spawn(function()
			local want = tostring(sessionData.tab or "")
			if want == "" then return end
			for _ = 1, 120 do
				for _, e in ipairs(tabEntries) do
					if tostring(e.tabName) == want then
						if activeTab ~= e and e.activate then e.activate() end
						return
					end
				end
				task.wait(0.1)
			end
		end)
		if sessionData.compact == true then
			task.delay(0.2, function() setCompact(true) end)
		end
	end


	tw(bStroke, { Transparency = C.strokeTrans }, 0.35)
	tw(badge, { BackgroundTransparency = 0 }, 0.35)
	tw(badgeLbl, { TextTransparency = 0 }, 0.35)
	tw(titleLbl, { TextTransparency = 0 }, 0.35)
	tw(subLbl, { TextTransparency = 0 }, 0.38)
	tw(barTrack, { BackgroundTransparency = 0 }, 0.35)
	tw(barFill, { Size = UDim2.new(1, 0, 1, 0) }, 0.78, Enum.EasingStyle.Quint)

	local done = false
	local function finish()
		if done then return end
		done = true
		tw(banner, { Size = UDim2.fromOffset(bw - 20, 66), BackgroundTransparency = 1 }, 0.25)
		tw(bStroke, { Transparency = 1 }, 0.22)
		tw(badge, { BackgroundTransparency = 1 }, 0.2)
		tw(badgeLbl, { TextTransparency = 1 }, 0.2)
		tw(titleLbl, { TextTransparency = 1 }, 0.2)
		tw(subLbl, { TextTransparency = 1 }, 0.2)
		tw(barTrack, { BackgroundTransparency = 1 }, 0.2)
		tw(barFill, { BackgroundTransparency = 1 }, 0.2)
		if onDone then task.delay(0.12, onDone) end
		task.delay(0.28, function() if banner.Parent then banner:Destroy() end end)
	end

	banner.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			finish()
		end
	end)
	task.delay(0.88, finish)
end


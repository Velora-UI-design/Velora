-- ==== HELPERS ====
local function newInst(cls, props)
	local o = Instance.new(cls)
	for k, v in pairs(props) do
		if k ~= "Parent" then o[k] = v end
	end
	if props.Parent then o.Parent = props.Parent end
	return o
end

local function corner(r, p)
	local c = Instance.new("UICorner")
	c.CornerRadius = (typeof(r) == "UDim") and r or UDim.new(0, r)
	c.Parent = p
	return c
end

local function stroke(col, thick, parent, trans)
	local s = Instance.new("UIStroke")
	s.Color = col
	s.Thickness = thick or 1
	s.Transparency = trans or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function padding(t, b, l, r, parent)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, t)
	p.PaddingBottom = UDim.new(0, b)
	p.PaddingLeft = UDim.new(0, l)
	p.PaddingRight = UDim.new(0, r)
	p.Parent = parent
	return p
end

local function listLayout(parent, gap, dir)
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap or 6)
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.Parent = parent
	return l
end

local function tw(obj, props, dur, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(dur or 0.28, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function spring(obj, props, dur)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(dur or 0.36, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function vGrad(parent, topCol, botCol, rot)
	local g = Instance.new("UIGradient")
	g.Rotation = rot or 90
	g.Color = ColorSequence.new(topCol, botCol)
	g.Parent = parent
	return g
end


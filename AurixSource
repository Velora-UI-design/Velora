	-- draggable pill with 6px tap threshold (so mobile taps open, drags move!)
	local pillDragging, pillMoved = false, false
	local pillGrabMouse, pillGrabOff = Vector2.zero, Vector2.zero
	showPrompt.InputBegan:Connect(function(i)
		if not hidden or animating then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			pillDragging = true
			pillMoved = false
			pillGrabMouse = UserInputService:GetMouseLocation()
			local anchorPos = showPrompt.AbsolutePosition + showPrompt.AbsoluteSize * showPrompt.AnchorPoint
			pillGrabOff = anchorPos - pillGrabMouse
		end
	end)
	track(UserInputService.InputEnded:Connect(function(i)
		if not pillDragging then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			pillDragging = false
			if not pillMoved then
				showUI()
			end
		end
	end))
	track(RunService.RenderStepped:Connect(function()
		if not pillDragging then return end
		local m = UserInputService:GetMouseLocation()
		if not pillMoved and (m - pillGrabMouse).Magnitude < 6 then return end
		pillMoved = true
		local t = m + pillGrabOff + getDragInset()
		local vp = getViewport(screen)
		local hw = showPrompt.AbsoluteSize.X / 2
		local x = math.clamp(t.X, hw + 8, math.max(hw + 8, vp.X - hw - 8))
		local y = math.clamp(t.Y, 8, math.max(8, vp.Y - showPrompt.AbsoluteSize.Y - 8))
		showPrompt.Position = UDim2.fromOffset(x, y)
	end))


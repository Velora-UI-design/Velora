	-- Snapshot every transparency before fading, so hiding and restoring never
	-- changes how an element was originally styled (labels used to come back
	-- opaque, and the window UIStroke kept a purple outline on screen).
	local uiSnapshot={}
	local function snapshotUI()
		uiSnapshot={}
		for _,c in ipairs(win:GetDescendants()) do
			local e={}
			if c:IsA("GuiObject") then e.bt=c.BackgroundTransparency end
			if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then e.tt=c.TextTransparency end
			if c:IsA("ImageLabel") or c:IsA("ImageButton") then e.it=c.ImageTransparency end
			if c:IsA("UIStroke") then e.st=c.Transparency end
			if next(e) then uiSnapshot[c]=e end
		end
	end

	local function setTreeAlpha(alpha,dur)
		for c,e in pairs(uiSnapshot) do
			if c.Parent then
				local props={}
				if e.bt~=nil then props.BackgroundTransparency=alpha end
				if e.tt~=nil then props.TextTransparency=alpha end
				if e.it~=nil then props.ImageTransparency=alpha end
				if e.st~=nil then props.Transparency=alpha end
				tw(c,props,dur)
			end
		end
	end

	local function restoreTree(dur)
		for c,e in pairs(uiSnapshot) do
			if c.Parent then
				local props={}
				if e.bt~=nil then props.BackgroundTransparency=e.bt end
				if e.tt~=nil then props.TextTransparency=e.tt end
				if e.it~=nil then props.ImageTransparency=e.it end
				if e.st~=nil then props.Transparency=e.st end
				tw(c,props,dur)
			end
		end
	end


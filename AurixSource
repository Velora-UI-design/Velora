	-- ==== ACTIVE FEATURES HUD ====
	local hudItems, hudPills = {}, {}
	local hudPanel, hudList, hudCount, hudEmpty, hudCtrl = nil, nil, nil, nil, nil

	local function hudEnabledCount()
		local n = 0
		for _, it in pairs(hudItems) do if it.get and it.get() then n = n + 1 end end
		return n
	end

	local function refreshHUD()
		if not hudPanel then return end
		local keys = {}
		for k in pairs(hudItems) do table.insert(keys, k) end
		table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
		for _, key in ipairs(keys) do
			local item = hudItems[key]
			local on = item.get and item.get() or false
			local pill = hudPills[key]
			if on and not pill then
				local p = newInst("TextButton", {
					Name = "Pill", Size = UDim2.new(1, 0, 0, 28),
					BackgroundColor3 = C.bgRowTop, BorderSizePixel = 0, Text = "",
					AutoButtonColor = false, ZIndex = 21, BackgroundTransparency = 1, Parent = hudList,
				})
				corner(9, p); stroke(C.rowStroke, 1, p, 0.4)
				local dot = newInst("Frame", {
					Size = UDim2.fromOffset(6, 6), Position = UDim2.new(0, 9, 0.5, -3),
					BackgroundColor3 = C.green, BorderSizePixel = 0, ZIndex = 22, Parent = p,
				}); corner(99, dot)
				newInst("TextLabel", {
					Size = UDim2.new(1, -44, 1, 0), Position = UDim2.new(0, 21, 0, 0),
					BackgroundTransparency = 1, Text = item.name or tostring(key), TextColor3 = C.textMain,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
					Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 22, Parent = p,
				})
				local vv = type(item.value) == "function" and item.value() or item.value
				if vv and vv ~= "" then
					newInst("TextLabel", {
						Name = "AurixHudValue", Size = UDim2.new(0, 48, 0, 16),
						Position = UDim2.new(1, -56, 0.5, -8), BackgroundTransparency = 1,
						Text = tostring(vv), TextColor3 = C.accent,
						TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.Gotham, TextSize = 9.5,
						ZIndex = 22, Parent = p,
					})
				end
				p.MouseButton1Click:Connect(function()
					if item.set then item.set(false) end
					refreshHUD()
				end)
				hudPills[key] = p
				tw(p, { BackgroundTransparency = 0 }, 0.2)
			elseif not on and pill then
				hudPills[key] = nil
				local dying = pill
				tw(dying, { BackgroundTransparency = 1 }, 0.16)
				task.delay(0.18, function() if dying.Parent then dying:Destroy() end end)
			elseif on and pill and item.value then
				local v = pill:FindFirstChild("AurixHudValue", true)
				if v then v.Text = tostring(type(item.value) == "function" and item.value() or item.value) end
			end
		end
		local n = hudEnabledCount()
		if hudCount then hudCount.Text = tostring(n) .. " ON" end
		if n == 0 and not hudEmpty then
			hudEmpty = newInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
				Text = "Nothing active", TextColor3 = C.textDim,
				Font = Enum.Font.Gotham, TextSize = 10, ZIndex = 21, Parent = hudList,
			})
		elseif n > 0 and hudEmpty then
			hudEmpty:Destroy(); hudEmpty = nil
		end
	end

	local function buildHUD(hcfg)
		hcfg = hcfg or {}
		hudPanel = newInst("Frame", {
			Name = "AurixHUD", Size = UDim2.new(0, 204, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,

		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			skip=true
		end
	end)

	local conn
	conn=RunSvc.RenderStepped:Connect(function(dt)
		if finished then conn:Disconnect();return end
		elapsed=math.min(1,elapsed+(dt/DUR)*(skip and 3.5 or 1))
		local p=loadProgress(elapsed)
		barFill.Size=UDim2.new(p/100,0,1,0)
